---
// Pelacak klik WA (riset §9): Cloudflare Web Analytics tidak punya custom event,
// jadi tiap tombol WA mengarah ke halaman vanity /wa/<konteks>/ — kunjungannya
// terhitung sebagai pageview (bisa dipecah per paket), lalu dialihkan ke wa.me.
// Redirect ditunda setelah load agar beacon sempat mengirim data; tanpa JS,
// meta-refresh di <noscript> tetap menjadi fallback.
// Target di-bake SAAT BUILD dari site.ts — situs statis tidak bisa membaca query string.
import type { GetStaticPaths } from "astro";
import AnalyticsBeacon from "../../components/AnalyticsBeacon.astro";
import { waLink } from "../../data/site";
import { packages } from "../../data/packages";
import { templates } from "../../data/templates";

export const getStaticPaths = (() => {
  // CATATAN: getStaticPaths diekstrak saat build — semua nilai harus dihitung DI DALAM fungsi
  // (const top-level komponen tidak terlihat dari sini).
  const contexts = [
    { slug: "umum", target: waLink({ type: "general" }) },
    { slug: "portfolio", target: waLink({ type: "project", projectTitle: "proyek di portfolio" }) },
    ...packages.map((p) => ({
      slug: `paket-${p.name.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`,
      target: waLink({ type: "package", packageName: `Paket ${p.name}` }),
    })),
    ...templates.map((t) => ({
      slug: `template-${t.slug}`,
      target: waLink({ type: "template", slug: t.slug, templateName: t.name }),
    })),
  ];
  return contexts.map(({ slug, target }) => ({ params: { slug }, props: { target } }));
}) satisfies GetStaticPaths;

const { slug } = Astro.params;
const { target } = Astro.props;
const baseUrl = new URL(`/wa/${slug}/`, Astro.site).toString();
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <title>Mengalihkan ke WhatsApp…</title>
    <!-- Beacon harus sempat mengirim pageview sebelum redirect. -->
    <AnalyticsBeacon />
    <noscript>
      <meta http-equiv="refresh" content={`0; url=${target}`} />
    </noscript>
    <!-- Halaman pengalih bukan konten: jangan diindeks (dan dikeluarkan dari sitemap di astro.config). -->
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href={baseUrl} />
    <style>
      body {
        font-family: ui-sans-serif, system-ui, sans-serif;
        display: grid;
        place-items: center;
        min-height: 100vh;
        color: #334155;
      }
    </style>
  </head>
  <body>
    <p>
      Membuka WhatsApp…
      <!-- Cadangan jika redirect diblokir browser: pengunjung tidak terjebak di halaman ini. -->
      <a id="wa-fallback" href={target} style="color:#0f766e">Klik di sini kalau tidak terbuka otomatis</a>
    </p>
    <script is:inline>
      // Delay singkat setelah load agar beacon CWA sempat mengirim pageview.
      window.addEventListener("load", () => {
        setTimeout(() => {
          const fallback = document.getElementById("wa-fallback");
          if (fallback instanceof HTMLAnchorElement) location.replace(fallback.href);
        }, 400);
      });
    </script>
  </body>
</html>
