---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaBanner from "../components/CtaBanner.astro";
import Icon from "../components/Icon.astro";
import { site } from "../data/site";
import dehan from "../assets/team/dehan.jpg";
import destra from "../assets/team/destra.jpg";

const values = [
  {
    title: "Transparan sejak proposal",
    text: "Termasuk, tidak termasuk, batas revisi, dan biaya revisi lewat batas — semua tertulis sebelum kamu transfer DP.",
  },
  {
    title: "Demo dulu, lunas kemudian",
    text: "Kamu menyetujui hasil di domain staging sebelum pelunasan. Website yang kamu approve, itulah yang tayang.",
  },
  {
    title: "Bicara dengan pembuatnya",
    text: "Tidak ada CS berlapis. Kamu chat, yang membalas adalah orang yang menulis kode dan mengurus proyek kamu.",
  },
];
---

<BaseLayout
  title="Tentang Kami — Studio Dua Orang dari Bandung"
  description="Pixcode Studio adalah studio web dua orang dari Bandung yang fokus membantu UMKM punya website — transparan soal harga, cakupan, dan proses."
  active="tentang"
>
  <section class="border-b border-slate-100 bg-slate-50 py-14 lg:py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <p class="text-xs font-bold uppercase tracking-widest text-brand-600">Tentang kami</p>
      <h1 class="mt-3 max-w-3xl text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl">
        Studio kecil dengan cara kerja yang rapi
      </h1>
      <p class="mt-4 max-w-3xl text-lg leading-relaxed text-slate-600">
        Kami dua orang dari {site.city} yang percaya usaha kecil deserve website yang jujur:
        harganya jelas, cakupannya jelas, dan pembuatnya bisa diajak bicara langsung.
      </p>
    </div>
  </section>

  <!-- Cerita -->
  <section class="py-16 lg:py-20">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <h2 class="text-2xl font-extrabold tracking-tight text-slate-900">Kenapa fokus ke UMKM?</h2>
      <div class="mt-5 space-y-4 leading-relaxed text-slate-600">
        <p>
          Kami sering melihat dua ekstrem: freelancer yang hilang setelah DP diterima, atau agency besar dengan harga
          yang tidak masuk akal untuk usaha kecil. Di antara keduanya, ada ruang untuk cara kerja yang lain —
          kecil, tapi tertata: proposal tertulis, demo sebelum lunas, dan batas revisi yang disepakati di awal.
        </p>
        <p>
          Pixcode Studio lahir dari semangat itu. Nama kami diambil dari bahan dasar pekerjaan kami:
          <strong class="font-semibold text-slate-900">pix</strong>el dan
          <strong class="font-semibold text-slate-900">code</strong> — detail kecil yang disusun rapi jadi sesuatu yang berfungsi.
          Sama seperti website usaha kamu: disusun dari bagian-bagian kecil yang jelas fungsinya satu per satu.
        </p>
      </div>
    </div>
  </section>

  <!-- Tim -->
  <section class="border-y border-slate-100 bg-slate-50 py-16 lg:py-20">
    <div class="mx-auto max-w-4xl px-4 sm:px-6">
      <h2 class="text-center text-2xl font-extrabold tracking-tight text-slate-900">Dua orang, peran jelas</h2>
      <div class="stagger mt-10 grid gap-6 sm:grid-cols-2">
        {
          [
            {
              photo: dehan,
              name: "Dehans",
              role: "Delivery Teknis",
              desc: "Menulis kode, deploy, testing, dan maintenance teknis. Yang kamu chat kalau ada perubahan teknis di website kamu.",
            },
            {
              photo: destra,
              name: "Destra",
              role: "Client Relations & Marketing",
              desc: "Closing, komunikasi progress, dan revisi request. Yang kamu chat pertama kali — dan yang memastikan kebutuhan kamu tersampaikan.",
            },
          ].map((p, idx) => (
            <div class="stagger-child card-lift rounded-2xl border border-slate-200 bg-white p-6 shadow-sm" style={`--i:${idx}`}>
              <Image
                src={p.photo}
                alt={`Foto ${p.name}`}
                width={112}
                height={112}
                fit="cover"
                position="top"
                loading="lazy"
                class="h-14 w-14 rounded-lg object-cover"
              />
              <h3 class="mt-4 text-lg font-bold text-slate-900">{p.name}</h3>
              <p class="text-sm font-semibold text-brand-700">{p.role}</p>
              <p class="mt-3 text-sm leading-relaxed text-slate-600">{p.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Nilai -->
  <section class="py-16 lg:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <h2 class="text-2xl font-extrabold tracking-tight text-slate-900">Cara kami bekerja</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {
          values.map((v) => (
            <div class="rounded-2xl border border-slate-200 p-6">
              <Icon name="check" class="h-5 w-5 text-brand-600" strokeWidth={2.5} />
              <h3 class="mt-3 font-bold text-slate-900">{v.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-slate-600">{v.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="pb-20">
    <CtaBanner
      title="Kenal lebih dekat? Langsung saja."
      subtitle="Chat kami — kamu akan tahu dalam 5 menit apakah kami cocok mengerjakan website usaha kamu."
    />
  </section>
</BaseLayout>
