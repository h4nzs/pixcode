---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaBanner from "../components/CtaBanner.astro";
import PageHero from "../components/PageHero.astro";
import Icon from "../components/Icon.astro";
import { site } from "../data/site";
import dehan from "../assets/team/dehan.jpg";
import destra from "../assets/team/destra.jpg";

const values = [
  {
    title: "Transparan sejak proposal",
    text: "Termasuk, tidak termasuk, batas revisi, dan biaya revisi lewat batas — semua tertulis sebelum kamu transfer DP.",
  },
  {
    title: "Demo dulu, lunas kemudian",
    text: "Kamu menyetujui hasil di domain staging sebelum pelunasan. Website yang kamu approve, itulah yang tayang.",
  },
  {
    title: "Bicara dengan pembuatnya",
    text: "Tidak ada CS berlapis. Kamu chat, yang membalas adalah orang yang menulis kode dan mengurus proyek kamu.",
  },
];
---

<BaseLayout
  title="Tentang Kami — Studio Dua Orang dari Bandung"
  description="Pixcode Studio adalah studio web dua orang dari Bandung yang fokus membantu UMKM punya website — transparan soal harga, cakupan, dan proses."
  active="tentang"
>
  <PageHero kicker="Tentang kami" title="Studio kecil dengan cara kerja yang rapi">
    <p class="text-slate-600">
      Kami dua orang dari {site.city} yang percaya usaha kecil layak punya website yang jujur:
      harganya jelas, cakupannya jelas, dan pembuatnya bisa diajak bicara langsung.
    </p>
  </PageHero>

  <!-- Cerita -->
  <section class="py-16 lg:py-24">
    <div class="wrap grid gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16">
      <h2 class="title text-[clamp(1.9rem,3.6vw,2.8rem)] text-slate-900">Kenapa fokus ke UMKM?</h2>
      <div class="reveal space-y-5 text-lg leading-relaxed text-slate-600">
        <p>
          Kami sering melihat dua ekstrem: freelancer yang hilang setelah DP diterima, atau agency besar dengan harga
          yang tidak masuk akal untuk usaha kecil. Di antara keduanya, ada ruang untuk cara kerja yang lain:
          kecil, tapi tertata. Proposal tertulis, demo sebelum lunas, dan batas revisi yang disepakati di awal.
        </p>
        <p>
          Pixcode Studio lahir dari semangat itu. Nama kami diambil dari bahan dasar pekerjaan kami:{" "}
          <strong class="font-bold text-slate-900">pix</strong>el dan{" "}
          <strong class="font-bold text-slate-900">code</strong>. Detail kecil yang disusun rapi jadi sesuatu yang berfungsi.
          Sama seperti website usaha kamu: disusun dari bagian-bagian kecil yang jelas fungsinya satu per satu.
        </p>
      </div>
    </div>
  </section>

  <!-- Tim -->
  <section class="bg-ink py-16 lg:py-24">
    <div class="wrap">
      <h2 class="title text-[clamp(1.9rem,3.6vw,2.8rem)] text-white">Dua orang, peran jelas<span class="pix pix-light" aria-hidden="true"></span></h2>
      <div class="stagger mt-12 grid gap-6 sm:grid-cols-2">
        {
          [
            {
              photo: dehan,
              name: "Dehans",
              role: "Delivery Teknis",
              desc: "Menulis kode, deploy, testing, dan maintenance teknis. Yang kamu chat kalau ada perubahan teknis di website kamu.",
            },
            {
              photo: destra,
              name: "Destra",
              role: "Client Relations & Marketing",
              desc: "Closing, komunikasi progress, dan revisi request. Yang kamu chat pertama kali, dan yang memastikan kebutuhan kamu tersampaikan.",
            },
          ].map((p, idx) => (
            <div class="stagger-child card-lift rounded-[1.75rem] border border-white/10 bg-white/5 p-7" style={`--i:${idx}`}>
              <Image
                src={p.photo}
                alt={`Foto ${p.name}`}
                width={160}
                height={160}
                fit="cover"
                position="top"
                loading="lazy"
                class="h-20 w-20 rounded-2xl object-cover"
              />
              <h3 class="mt-6 text-2xl font-extrabold tracking-tight text-white">{p.name}</h3>
              <p class="text-sm font-bold text-brand-300">{p.role}</p>
              <p class="mt-4 leading-relaxed text-slate-300">{p.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Nilai: anak tangga, tiap kartu naik satu tingkat -->
  <section class="py-16 lg:py-24">
    <div class="wrap">
      <h2 class="title text-[clamp(1.9rem,3.6vw,2.8rem)] text-slate-900">Cara kami bekerja</h2>
      <div class="stagger mt-12 grid items-end gap-6 md:grid-cols-3">
        {
          values.map((v, i) => (
            <div
              class="stagger-child card-lift flex flex-col rounded-[1.75rem] border border-line bg-white p-7 md:min-h-[var(--h)]"
              style={`--i:${i};--h:${15 + i * 3.5}rem`}
            >
              <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
                <Icon name="check" class="h-5 w-5" strokeWidth={2.75} />
              </span>
              <h3 class="mt-5 text-xl font-extrabold tracking-tight text-slate-900">{v.title}</h3>
              <p class="mt-3 leading-relaxed text-slate-600">{v.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBanner
    title="Kenal lebih dekat? Langsung saja."
    subtitle="Chat kami. Kamu akan tahu dalam 5 menit apakah kami cocok mengerjakan website usaha kamu."
  />
</BaseLayout>
