---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import PackageCard from "../components/PackageCard.astro";
import FaqItem from "../components/FaqItem.astro";
import CtaBanner from "../components/CtaBanner.astro";
import PageHero from "../components/PageHero.astro";
import { packages } from "../data/packages";
import { addons } from "../data/addons";

const faqs = [
  {
    q: "Apa artinya harga \"mulai dari\"?",
    a: "Harga mulai dari sudah mencakup semua yang ada di daftar \"termasuk\" pada kartu paket. Kebutuhan di luar daftar, misalnya halaman atau konten tambahan, desain khusus, dan fitur lain, dihitung terpisah. Setelah konsultasi singkat, totalnya dikunci tertulis di proposal dan tidak berubah.",
  },
  {
    q: "Apa yang membuat total lebih tinggi dari harga mulai?",
    a: "Jumlah halaman/konten yang lebih banyak, kebutuhan desain khusus, atau fitur tambahan di luar daftar 'termasuk'. Semua dihitung dan disepakati sebelum DP — tidak ada tambahan diam-diam di tengah jalan.",
  },
  {
    q: "Apa bedanya paket UMKM dan Hemat?",
    a: "Paket UMKM memakai salah satu template siap pakai: struktur, huruf, dan gaya gerak tetap, yang kamu ganti adalah isi, foto, logo, dan satu warna aksen. Paket Hemat tetap 1 halaman, tapi tampilannya disesuaikan dengan identitas usahamu: sampai 2 warna, huruf pilihan, dan susunan section mengikuti kebutuhan.",
  },
  {
    q: "Kapan saya harus pindah ke paket yang lebih tinggi?",
    a: "Kalau kamu butuh login, data yang tersimpan, atau pembayaran di website, itu paket Standar. Di luar itu, kebutuhan kecil jadi add-on. Kalau total paket ditambah add-on sudah mencapai harga paket di atasnya, kami sarankan paket di atasnya. Biaya paket yang sudah dibayar dikurangkan penuh bila kamu naik paket sebelum demo pertama, dan 50% bila setelah demo.",
  },
  {
    q: "Berapa biaya revisi di luar batas paket?",
    a: "Revisi melebihi batas otomatis dikenakan biaya per revisi: Paket UMKM dan Hemat Rp 100.000, Hemat Plus Rp 150.000, Standar/Dynamic dan Desktop POS Rp 300.000–500.000 tergantung kompleksitas. Rate ini sudah dicantumkan di proposal sejak awal.",
  },
  {
    q: "Apakah harga paket sudah termasuk domain dan hosting?",
    a: "Paket UMKM dan Hemat memakai layanan gratis Cloudflare dengan alamat bawaan, jadi tidak ada biaya hosting dari kami selama masih dalam batas dan ketentuan layanan Cloudflare. Domain sendiri sudah dipasangkan di Hemat Plus ke atas (add-on Rp 150.000 untuk UMKM dan Hemat); domainnya dibeli terpisah dengan kisaran Rp 140–280 ribu per tahun. Paket Standar butuh server yang dibayar langsung ke penyedia atas namamu tanpa markup dari kami, perkiraan Rp 0,7–1,3 juta per tahun bersama domain. Nominal pastinya dicantumkan di proposal sebelum DP.",
  },
  {
    q: "Bagaimana dengan hosting dan maintenance?",
    a: "Opsional dan tidak ada kewajiban. Website statis tidak butuh biaya rawat; perubahan kecil setelah live Rp 50.000 per permintaan (maksimal 30 menit), atau 5 permintaan Rp 200.000. Paket Standar punya Rawat server Rp 500.000 per tahun: pemantauan, backup mingguan, dan pembaruan keamanan.",
  },
  {
    q: "Apakah bisa request fitur di luar paket?",
    a: "Bisa. Fitur tambahan dihitung sebagai add-on dan dikutip tertulis sebelum pengerjaan dimulai, lengkap dengan tambahan waktunya. Kami baru mengerjakannya setelah kamu setuju, jadi tidak ada tagihan kejutan.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<BaseLayout
  title="Layanan & Harga Paket Website"
  description="5 paket pembuatan website untuk UMKM: dari Rp 400.000 (Paket UMKM) sampai aplikasi kasir mulai Rp 6 juta. Termasuk/tidak termasuk tertulis, batas revisi jelas, DP 50%."
  active="layanan"
  schema={schema}
>
  <!-- Answer block GEO (riset §6): jawaban langsung di atas -->
  <PageHero kicker="Layanan dan harga" title="Pilih paket. Semua ketentuannya tertulis di sini">
    <p class="text-slate-600">
      Biaya pembuatan website untuk UMKM di Pixcode Studio mulai{" "}
      <strong class="font-bold text-slate-900">Rp 400.000</strong> (Paket UMKM), dan aplikasi kasir (Desktop POS) mulai{" "}
      <strong class="font-bold text-slate-900">Rp 6.000.000</strong>, diperbarui Oktober 2026.
      Setiap paket punya daftar termasuk, tidak termasuk, dan batas revisi yang eksplisit. Harga final dikunci di proposal sebelum DP.
    </p>
  </PageHero>

  <!-- Grid paket -->
  <section class="py-16 lg:py-24">
    <div class="wrap">
      <h2 class="sr-only">Daftar paket</h2>
      <div class="stagger grid gap-6 pt-3 md:grid-cols-2 xl:grid-cols-3">
        {
          packages.map((pkg, i) => (
            <div class="stagger-child" style={`--i:${i}`}>
              <PackageCard pkg={pkg} />
            </div>
          ))
        }
      </div>

      <!-- Trust line tepat di bawah grid harga (riset §7) -->
      <div class="reveal mt-14 grid gap-6 rounded-[1.75rem] bg-brand-50 p-7 sm:p-9 lg:grid-cols-[1.4fr_1fr] lg:items-center">
        <p class="text-lg leading-snug text-brand-900">
          <strong class="font-extrabold">DP 50% saat mulai, pelunasan 50% setelah kamu approve demo di domain staging.</strong>{" "}
          Website sudah kamu lihat dan setujui dulu, baru lunas.
        </p>
        <div class="space-y-2 text-sm text-brand-900/80">
          <p>
            Mau lihat dulu tampilannya?
            <a href="/template/" class="font-bold text-brand-700 underline underline-offset-4 hover:text-brand-900">Buka tiga contoh template Paket UMKM</a>.
          </p>
          <p>
            Estimasi pengerjaan dihitung sejak materi (foto, teks) lengkap. Biaya domain tidak termasuk dalam harga paket dan
            dicantumkan terpisah di proposal.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Add-on (sumber: src/data/addons.ts) -->
  <section id="addon" class="border-t border-line py-16 lg:py-24">
    <div class="wrap">
      <SectionHeading
        kicker="Add-on"
        title="Apa saja add-on dan berapa harganya?"
        subtitle="Add-on untuk kebutuhan kecil yang tidak mengubah jenis paket. Totalnya dikunci tertulis di proposal sebelum DP."
      />
      <ul class="reveal mt-12 divide-y divide-line border-y border-line">
        {
          addons.map((a) => (
            <li class="grid gap-1 py-5 transition-colors hover:bg-slate-50 sm:grid-cols-[1fr_auto] sm:gap-x-8 sm:px-3">
              <div>
                <p class="text-lg font-extrabold tracking-tight text-slate-900">{a.name}</p>
                {a.note && <p class="mt-0.5 text-sm text-slate-600">{a.note}</p>}
                <p class="mt-1 text-xs text-slate-500">Untuk: {a.appliesTo}</p>
              </div>
              <p class="font-extrabold text-brand-600 sm:text-right sm:text-lg">{a.price}</p>
            </li>
          ))
        }
      </ul>

      <div class="reveal mt-12 rounded-[1.75rem] bg-ink p-7 text-slate-300 sm:p-9">
        <h3 class="text-xl font-extrabold tracking-tight text-white">Ketentuan untuk semua paket</h3>
        <ul class="mt-5 list-disc space-y-3 pl-5 marker:text-brand-500 leading-relaxed">
          <li>Permintaan di luar daftar ditulis lengkap dengan harga dan tambahan waktu. Kami mengerjakannya setelah kamu setuju tertulis; WhatsApp cukup.</li>
          <li>Naik paket: biaya paket yang sudah dibayar dikurangkan penuh bila diputuskan sebelum demo pertama, dan 50% bila setelah demo.</li>
          <li>Garansi perbaikan bug gratis 14 hari sejak website diserahkan (live).</li>
          <li>Biaya tahun berikutnya: UMKM dan Hemat di alamat bawaan Rp 0. Dengan domain sendiri, hanya perpanjangan domain ke penyedia. Paket Standar: server dan domain.</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- FAQ harga (H2 pertanyaan nyata — GEO) -->
  <section class="border-t border-line bg-slate-50 py-16 lg:py-24">
    <div class="wrap grid gap-12 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16">
      <div class="lg:sticky lg:top-28 lg:self-start">
        <SectionHeading
          kicker="FAQ harga"
          title="Pertanyaan soal harga dan ketentuan"
          subtitle="Jawaban singkat dan langsung. Detail lengkapnya dijelaskan saat konsultasi."
        />
      </div>
      <div class="reveal">
        {faqs.map((f) => <FaqItem question={f.q} answer={f.a} />)}
      </div>
    </div>
  </section>

  <CtaBanner
    title="Masih ragu pilih paket yang mana?"
    subtitle="Ceritakan usaha dan kebutuhan kamu. Kami rekomendasikan yang paling pas, bukan yang paling mahal."
  />
</BaseLayout>
