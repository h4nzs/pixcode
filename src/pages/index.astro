---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import PackageSelector from "../components/PackageSelector.astro";
import HeroPanel from "../components/HeroPanel.astro";
import ProjectCard from "../components/ProjectCard.astro";
import WaButton from "../components/WaButton.astro";
import CtaBanner from "../components/CtaBanner.astro";
import FaqItem from "../components/FaqItem.astro";
import Icon from "../components/Icon.astro";
import { templates } from "../data/templates";
import { templateImage } from "../utils/templateImage";

// Top-3 Home: situs yang sedang aktif dulu (hero berjanji "sedang dipakai usaha nyata"),
// lalu proyek klien, lalu tahun terbaru. Proyek yang nonaktif sementara tetap ada di /portfolio.
const isOffline = (p: { data: { liveStatus: string } }) => (p.data.liveStatus === "temporarily-offline" ? 1 : 0);
const featuredProjects = (await getCollection("projects", ({ data }) => data.featured))
  .sort(
    (a, b) =>
      isOffline(a) - isOffline(b) ||
      (a.data.internalLabel ? 1 : 0) - (b.data.internalLabel ? 1 : 0) ||
      b.data.year - a.data.year,
  )
  .slice(0, 3);

// ---- FAQ (juga dipakai FAQPage schema — riset §6: jawaban siap-kutip 2–3 kalimat) ----
const faqs = [
  {
    q: "Berapa biaya buat website untuk UMKM?",
    a: "Di Pixcode Studio mulai Rp 400.000 (Paket UMKM) untuk 1 halaman profil usaha dengan tombol WhatsApp dan lokasi. Paket lebih lengkap tersedia, termasuk aplikasi kasir (POS) mulai Rp 6.000.000. Detail tiap paket ada di halaman Layanan.",
  },
  {
    q: "Apakah Pixcode Studio melayani di luar Bandung?",
    a: "Melayani. Basis kami di Bandung, tetapi proyek dikerjakan jarak jauh untuk klien di Jabodetabek (Jakarta, Bogor, Depok, Tangerang, Bekasi), Surabaya, Medan, Semarang, dan seluruh kota lainnya di Indonesia. Konsultasi, demo, dan revisi berjalan lewat WhatsApp dan video call, jadi lokasi tidak jadi hambatan.",
  },
  {
    q: "Bagaimana sistem pembayarannya?",
    a: "DP 50% setelah kesepakatan, pelunasan 50% setelah kamu approve demo website di domain staging. Jadi website sudah kamu lihat dan setuju dulu, baru pembayaran dilunasi. Aplikasi kasir (POS) dibayar tiga tahap: 40%, 30% setelah demo, dan 30% setelah instalasi.",
  },
  {
    q: "Berapa lama pengerjaannya?",
    a: "Paket 1 halaman umumnya selesai 3–7 hari kerja setelah materi (foto, teks) lengkap. Paket dengan admin & database 2–4 minggu. Kalau materi dari kita yang menunggu, timeline menyesuaikan dan kami kabari dari awal.",
  },
  {
    q: "Kalau ada yang mau diubah, berapa kali revisi?",
    a: "Sudah tertulis per paket: 1x untuk Paket UMKM dan Hemat, 2x untuk Hemat Plus, Standar/Dynamic, dan Desktop POS — ditetapkan di proposal sebelum DP. Revisi di luar batas dikenakan biaya tambahan yang juga sudah diumumkan di awal, tanpa kejutan belakangan.",
  },
  {
    q: "Domain dan hosting atas nama siapa?",
    a: "Idealnya didaftarkan atas nama/email kamu sendiri — kami bantu prosesnya. Kalau sementara memakai akun kami, prosedur transfer kepemilikan setelah pelunasan dijelaskan tertulis di awal.",
  },
  {
    q: "Setelah website live, kalau ada masalah bagaimana?",
    a: "Perbaikan bug gratis 14 hari sejak website diserahkan. Setelahnya, perubahan kecil Rp 50.000 per permintaan, dan paket Standar punya opsi rawat server Rp 500.000 per tahun. Semuanya opsional; daftar lengkapnya ada di halaman Layanan.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const steps = [
  {
    n: "1",
    title: "Konsultasi & pilih paket",
    text: "Ceritakan kebutuhan via WhatsApp. Kami bantu pilih paket yang pas — harga dan cakupan sudah jelas di awal, tertulis di proposal.",
  },
  {
    n: "2",
    title: "DP 50%, pengerjaan dimulai",
    text: "Proyek dibuka setelah DP. Kamu dapat update progress berkala — tidak perlu mengejar kabar.",
  },
  {
    n: "3",
    title: "Demo staging & revisi",
    text: "Website kamu tinjau di domain staging. Revisi sesuai batas paket — jelas berapa kali, jelas biayanya kalau lebih.",
  },
  {
    n: "4",
    title: "Approve, live & support",
    text: "Setelah kamu setuju, pelunasan, website tayang di domain final, lengkap dengan panduan singkat. Perawatan opsional, bukan paksaan.",
  },
];

// Hero memakai dua karya nyata dari daftar unggulan; blok ketiga adalah contoh template.
const heroTop = featuredProjects[1] ?? featuredProjects[0];
const heroMid = featuredProjects[2] ?? featuredProjects[0];

// Angka di strip ini diambil dari paket dan ketentuan yang tertulis (src/data/packages.ts, syarat-ketentuan).
const facts = [
  { value: "Rp 400.000", label: "Paket UMKM, harga flat. Tidak ada biaya hosting dari kami." },
  { value: "3–7 hari", label: "kerja untuk paket 1 halaman, dihitung sejak foto dan teks lengkap." },
  { value: "DP 50%", label: "Sisanya lunas setelah kamu menyetujui demo di alamat staging." },
  { value: "14 hari", label: "garansi perbaikan bug gratis sejak website diserahkan." },
];

---

<BaseLayout
  title="Jasa Pembuatan Website UMKM Bandung — Mulai Rp 400.000"
  active="home"
  schema={schema}
>
  <!-- ============ HERO ============ -->
  <section class="bg-brand-600 p-3 pb-5 sm:p-4 sm:pb-6 lg:p-5 lg:pb-7">
    <div class="relative overflow-hidden rounded-[1.75rem] bg-slate-50 shadow-[0_2px_6px_rgb(2_23_22/0.15),0_40px_70px_-34px_rgb(2_23_22/0.65)] sm:rounded-[2.25rem]">
      <div class="relative mx-auto grid max-w-[76rem] gap-14 px-6 pb-16 pt-12 sm:px-10 sm:pt-14 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,1fr)] lg:items-center lg:gap-12 lg:px-12 lg:pb-20 lg:pt-16">
      <div class="relative z-10">
        <p class="hero-seq flex items-center gap-2.5 text-sm font-bold text-brand-700" style="--d:0">
          <span class="h-2.5 w-2.5 rounded-[3px] bg-brand-500" aria-hidden="true"></span>
          Studio web dari Bandung, melayani seluruh Indonesia
        </p>
        <h1 class="display mt-7 whitespace-nowrap text-[clamp(2.4rem,5vw,4.5rem)]">
          <span class="line"><span style="--d:0">Website jelas<span class="sr-only">.</span><span class="pix" aria-hidden="true"></span></span></span>
          <span class="line"><span style="--d:1">Harga jelas<span class="sr-only">.</span><span class="pix" aria-hidden="true"></span></span></span>
          <span class="line"><span style="--d:2">Proses jelas<span class="sr-only">.</span><span class="pix" aria-hidden="true"></span></span></span>
        </h1>
        <p class="hero-seq mt-8 max-w-[30rem] text-lg leading-relaxed text-slate-600" style="--d:3">
          Jasa pembuatan website dan aplikasi untuk usaha kecil. Mulai <strong class="font-bold text-slate-900">Rp 400.000</strong>,
          batas revisi tertulis di proposal, dan kamu lihat demonya dulu sebelum melunasi.
        </p>
        <div class="hero-seq mt-9 flex flex-wrap items-center gap-3" style="--d:4">
          <WaButton context={{ type: "general" }} size="large" label="Tanya-tanya dulu, gratis" />
          <a
            href="/layanan/"
            class="btn-press inline-flex items-center gap-2.5 rounded-xl border border-slate-300 px-6 py-4 text-base font-bold text-slate-900 hover:border-slate-900"
          >
            Lihat paket dan harga
            <Icon name="arrow-right" class="arrow h-5 w-5" />
          </a>
        </div>
        <p class="hero-seq mt-5 flex items-center gap-2 text-sm text-slate-500" style="--d:5">
          <Icon name="clock" class="h-4 w-4 text-brand-600" />
          Balasan di jam kerja, langsung ke orang yang mengerjakan.
        </p>
      </div>

        <HeroPanel top={heroTop} mid={heroMid} />
      </div>
    </div>
  </section>

  <!-- ============ ANGKA YANG TERTULIS ============ -->
  <section class="bg-ink" aria-label="Ketentuan utama">
    <div class="wrap">
      <dl class="stagger grid sm:grid-cols-2 lg:grid-cols-4">
        {
          facts.map((f, i) => (
            <div class="stagger-child border-white/10 py-9 sm:px-8 sm:first:pl-0 lg:border-l lg:first:border-l-0 [&:nth-child(n+2)]:border-t sm:[&:nth-child(n+2)]:border-t-0 sm:[&:nth-child(n+3)]:border-t lg:[&:nth-child(n+3)]:border-t-0" style={`--i:${i}`}>
              <dt class="display whitespace-nowrap text-[clamp(2.1rem,3.3vw,3rem)] text-white">{f.value}</dt>
              <dd class="mt-3 max-w-[16rem] text-[0.95rem] leading-relaxed text-slate-300">{f.label}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- ============ CONTOH TEMPLATE (Paket UMKM) ============ -->
  <section class="py-24 lg:py-32">
    <div class="wrap">
      <div class="grid gap-8 lg:grid-cols-[1.25fr_1fr] lg:items-end lg:gap-16">
        <SectionHeading kicker="Paket UMKM" title="Buka contohnya dulu. Baru putuskan." />
        <div class="reveal">
          <p class="text-lg leading-relaxed text-slate-600">
            Paket UMKM dibuat dari tiga template ini. Yang kamu ganti: nama, logo, teks, foto, jam buka, lokasi, dan satu warna aksen.
            Usaha di contoh adalah fiktif; semuanya bisa kamu buka dan coba.
          </p>
          <a href="/template/" class="group mt-5 inline-flex items-center gap-2 font-bold text-brand-700 underline decoration-brand-500/40 underline-offset-8 hover:decoration-brand-600">
            Lihat semua contoh
            <Icon name="arrow-right" class="h-5 w-5 transition-transform duration-300 group-hover:translate-x-1" />
          </a>
        </div>
      </div>

      <ul class="stagger mt-14 grid gap-x-8 gap-y-14 md:grid-cols-3">
        {
          templates.map((t, i) => (
            <li class="stagger-child md:[&:nth-child(1)]:mt-16 md:[&:nth-child(2)]:mt-8" style={`--i:${i}`}>
              <a href={`/template/${t.slug}/`} class="group block focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-600">
                <div class="relative overflow-hidden rounded-[1.5rem] bg-slate-100 ring-1 ring-line">
                  <Image
                    src={templateImage(t.image)}
                    alt={`Contoh template ${t.name}: ${t.business}`}
                    width={640}
                    height={480}
                    loading="lazy"
                    class="aspect-[4/3] w-full object-cover object-top transition-transform duration-[900ms] ease-[var(--ease-out-soft)] group-hover:scale-[1.05]"
                  />
                  <span class="absolute right-4 top-4 flex h-10 w-10 translate-y-1 items-center justify-center rounded-full bg-white text-slate-900 opacity-0 transition-all duration-500 group-hover:translate-y-0 group-hover:opacity-100 group-focus-visible:translate-y-0 group-focus-visible:opacity-100">
                    <Icon name="arrow-up-right" class="h-5 w-5" strokeWidth={2.25} />
                  </span>
                </div>
                <h3 class="mt-5 text-xl font-extrabold tracking-tight text-slate-900">{t.name}</h3>
                <p class="mt-1 text-sm leading-relaxed text-slate-600">{t.suitableFor}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ============ PAKET ============ -->
  <section class="bg-slate-50 py-24 lg:py-32" id="paket">
    <div class="wrap">
      <SectionHeading
        kicker="Paket dan harga"
        title="Harga terpampang. Termasuk dan tidak termasuk, tertulis."
        subtitle={'Tidak ada "hubungi kami untuk tahu harga". Pilih yang sesuai anggaran, tanya sisanya lewat WhatsApp.'}
      />
      <div class="reveal mt-14">
        <PackageSelector />
      </div>
    </div>
  </section>

  <!-- ============ CARA KERJA: tangga empat langkah ============ -->
  <section class="overflow-hidden py-24 lg:py-32">
    <div class="wrap">
      <SectionHeading kicker="Cara kerja" title="Empat langkah, naik satu per satu." subtitle="Proses ini tertulis di setiap proposal, bukan janji lisan." />
      <ol class="stagger mt-14 grid gap-5 md:grid-cols-2 lg:grid-cols-4 lg:items-end lg:gap-6">
        {
          steps.map((s, i) => (
            <li
              class:list={[
                "stagger-child flex flex-col justify-between gap-8 rounded-[1.5rem] p-7 lg:min-h-[calc(15.5rem+var(--n)*4.25rem)]",
                i === 3 ? "bg-brand-600 text-brand-50" : "bg-brand-100 text-slate-700",
              ]}
              style={`--i:${i};--n:${i}`}
            >
              <span class:list={["display block text-[4.5rem]", i === 3 ? "text-brand-300" : "text-brand-600"]} aria-hidden="true">{s.n}</span>
              <div>
                <h3 class:list={["text-lg font-extrabold tracking-tight", i === 3 ? "text-white" : "text-slate-900"]}>{s.title}</h3>
                <p class="mt-2.5 text-[0.95rem] leading-relaxed">{s.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ============ KARYA ============ -->
  <section class="bg-ink py-24 lg:py-32">
    <div class="wrap">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <SectionHeading dark kicker="Karya" title="Website yang sedang dipakai usaha nyata." subtitle="Klik untuk melihat detail, termasuk tautan website yang bisa kamu buka sendiri." />
        <a href="/portfolio/" class="group inline-flex items-center gap-2 font-bold text-white underline decoration-white/30 underline-offset-8 hover:decoration-white">
          Lihat semua proyek
          <Icon name="arrow-right" class="h-5 w-5 transition-transform duration-300 group-hover:translate-x-1" />
        </a>
      </div>
      <div class="stagger mt-14 grid gap-x-8 gap-y-14 lg:grid-cols-12">
        {
          featuredProjects.map((p, i) => (
            <div class={i === 0 ? "contents lg:block lg:col-span-7 lg:row-span-2" : "contents lg:block lg:col-span-5"}>
              <ProjectCard project={p} index={i} dark ratio={i === 0 ? "aspect-[4/3]" : "aspect-[16/10]"} width={i === 0 ? 900 : 640} />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ FAQ ============ -->
  <section class="py-24 lg:py-32">
    <div class="wrap grid gap-12 lg:grid-cols-[1fr_1.5fr] lg:gap-20">
      <div class="lg:sticky lg:top-28 lg:self-start">
        <SectionHeading kicker="FAQ" title="Pertanyaan yang paling sering masuk." />
        <p class="mt-6 max-w-sm leading-relaxed text-slate-600">Belum ketemu jawabannya? Tanya langsung, dibalas di jam kerja.</p>
        <div class="mt-7">
          <WaButton context={{ type: "general" }} variant="ghost" label="Tanya lewat WhatsApp" />
        </div>
      </div>
      <div class="reveal border-t border-line">
        {faqs.map((f) => <FaqItem question={f.q} answer={f.a} />)}
      </div>
    </div>
  </section>

  <CtaBanner />
</BaseLayout>
