---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import WaButton from "../../components/WaButton.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import Icon from "../../components/Icon.astro";
import { fullUrl } from "../../data/site";
import { packages } from "../../data/packages";
import { projectImage } from "../../utils/projectImage";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { title, client, category, package: pkgId, internalLabel, year, thumbnail, gallery, liveUrl, liveStatus, repoUrl, description, benefit, challenge, before, after, stack, features } = project.data;
const thumb = projectImage(thumbnail);
const galleryImgs = gallery.map((g) => projectImage(g));

const pkgName = pkgId ? packages.find((p) => p.id === pkgId)?.name : undefined;
const categoryLabel = { website: "Website", "web-app": "Web App", pos: "POS" }[category];

// Proyek lain (maks 3, tanpa proyek ini)
const others = (await getCollection("projects", (p) => p.id !== project.id)).slice(0, 3);

const schema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: fullUrl("/") },
    { "@type": "ListItem", position: 2, name: "Portfolio", item: fullUrl("/portfolio/") },
    { "@type": "ListItem", position: 3, name: title, item: fullUrl(`/portfolio/${project.id}/`) },
  ],
};
---

<BaseLayout
  title={`${title} — Studi Kasus`}
  description={description}
  active="portfolio"
  schema={schema}
>
  <article class="py-12 lg:py-20">
    <div class="wrap">
      <!-- Breadcrumb -->
      <nav aria-label="Breadcrumb" class="text-sm text-slate-500">
        <a href="/portfolio/" class="hover:text-brand-700">Portfolio</a>
        <span class="mx-2 text-slate-300">/</span>
        <span class="text-slate-700" aria-current="page">{title}</span>
      </nav>

      <header class="mt-8 max-w-4xl">
        {
          internalLabel && (
            <p class="inline-block rounded-lg bg-slate-100 px-3 py-1 text-xs font-bold text-slate-600">
              {internalLabel}
            </p>
          )
        }
        <h1 class="display hero-seq mt-4 text-[clamp(2.4rem,5.4vw,4.4rem)]">{title}<span class="pix" aria-hidden="true"></span></h1>
        <p class="hero-seq mt-5 text-base text-slate-500" style="--d:1">
          {internalLabel ? client : `Klien: ${client}`}
          <span class="mx-1.5 text-slate-300">·</span>
          {categoryLabel}
          {pkgName && <><span class="mx-1.5 text-slate-300">·</span>Paket {pkgName}</>}
          <span class="mx-1.5 text-slate-300">·</span>
          {year}
          {
            liveStatus === "temporarily-offline" && (
              <>
                <span class="mx-1.5 text-slate-300">·</span>
                <span class="inline-flex items-center gap-1 rounded-full bg-amber-50 px-2 py-0.5 text-xs font-semibold text-amber-700" title="Situs live dinonaktifkan sementara oleh klien">
                  <Icon name="clock" class="h-3 w-3" />
                  Situs live nonaktif sementara
                </span>
                <span class="sr-only">(dinonaktifkan sementara oleh klien)</span>
                {" "}
              </>
            )
          }
        </p>
      </header>

      <!-- Hero: rasio asli screenshot dipertahankan (tanpa crop) — aset asli dari user. -->
      <div class="reveal mt-10 overflow-hidden rounded-[1.75rem] bg-slate-100 ring-1 ring-line">
        <Image
          src={thumb}
          alt={`Tampilan utama ${title}`}
          width={1200}
          loading="eager"
          class="h-auto w-full"
        />
      </div>

      <div class="mt-14 grid gap-12 lg:grid-cols-[1.6fr_1fr] lg:gap-16">
        <div>
          <h2 class="title text-2xl text-slate-900">Tentang proyek ini</h2>
          <p class="mt-4 text-lg leading-relaxed text-slate-600">{description}</p>

          {/* Studi kasus: Tantangan + Before→After (usulan 2026-09-23) — section hanya muncul saat field diisi. */}
          {
            challenge && (
              <>
                <h2 class="title mt-14 text-2xl text-slate-900">Tantangan</h2>
                <p class="mt-3 leading-relaxed text-slate-600">{challenge}</p>
              </>
            )
          }

          {
            before && after && (
              <>
                <h2 class="title mt-14 text-2xl text-slate-900">Sebelum & sesudah</h2>
                <div class="mt-4 grid gap-3 sm:grid-cols-[1fr_auto_1fr] sm:items-stretch">
                  <div class="rounded-2xl border border-line bg-slate-50 p-6">
                    <h3 class="text-sm font-bold text-slate-500">Sebelum</h3>
                    <p class="mt-2 leading-relaxed text-slate-600">{before}</p>
                  </div>
                  <div class="flex items-center justify-center">
                    <Icon name="arrow-right" class="hidden h-5 w-5 shrink-0 text-brand-600 sm:block" />
                    <span class="text-slate-300 sm:hidden" aria-hidden="true">↓</span>
                  </div>
                  <div class="rounded-2xl bg-brand-600 p-6">
                    <h3 class="text-sm font-bold text-brand-100">Sesudah</h3>
                    <p class="mt-2 leading-relaxed text-white">{after}</p>
                  </div>
                </div>
              </>
            )
          }

          <!-- Manfaat bagi pemilik usaha — wajib (riset §3) -->
          <div class="mt-8 rounded-2xl bg-brand-50 p-6">
            <h3 class="flex items-center gap-2.5 text-sm font-bold text-brand-700"><span class="h-2.5 w-2.5 rounded-[3px] bg-brand-500" aria-hidden="true"></span>Manfaat bagi pemilik usaha</h3>
            <p class="mt-2 leading-relaxed text-brand-900">{benefit}</p>
          </div>

          {
            features.length > 0 && (
              <>
                <h2 class="title mt-14 text-2xl text-slate-900">Fitur utama</h2>
                <ul class="mt-4 grid gap-2.5 sm:grid-cols-2">
                  {features.map((f) => (
                    <li class="flex items-start gap-2 text-sm text-slate-700">
                      <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-brand-600" strokeWidth={2.5} />
                      {f}
                    </li>
                  ))}
                </ul>
              </>
            )
          }

          {
            stack.length > 0 && (
              <>
                <h2 class="title mt-14 text-2xl text-slate-900">Teknologi & tools</h2>
                <ul class="mt-4 flex flex-wrap gap-2">
                  {stack.map((tech) => (
                    <li class="rounded-lg border border-line bg-white px-3 py-1.5 text-xs font-bold text-slate-600">
                      {tech}
                    </li>
                  ))}
                </ul>
              </>
            )
          }

          {
            gallery.length > 0 && (
              <>
                <h2 class="title mt-14 text-2xl text-slate-900">Galeri</h2>
                <div class="mt-4 grid gap-4 sm:grid-cols-2">
                  {galleryImgs.map((img, i) => (
                    <Image
                      src={img}
                      alt={`Screenshot ${i + 1} dari ${title}`}
                      width={600}
                      height={450}
                      loading="lazy"
                      class="rounded-2xl ring-1 ring-line object-cover"
                    />
                  ))}
                </div>
              </>
            )
          }
        </div>

        <!-- Sidebar -->
        <aside class="h-fit rounded-[1.75rem] bg-ink p-7 lg:sticky lg:top-28">
          <h2 class="title text-2xl text-white">Tertarik dengan hasil serupa?</h2>
          <p class="mt-3 text-slate-300">
            Kami buatkan yang sesuai kebutuhan usaha kamu — mulai dari obrolan ringan, tanpa komitmen.
          </p>
          <div class="mt-4">
            <WaButton
              context={{ type: "project", projectTitle: title }}
              label="Diskusikan proyek serupa"
              class="w-full"
            />
          </div>

          <ul class="mt-6 space-y-3 border-t border-white/10 pt-6 text-sm text-slate-300">
            {
              liveUrl && (
                <li>
                  <a
                    href={liveUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 font-bold text-brand-300 hover:text-white"
                  >
                    <Icon name="external-link" class="h-4 w-4" />
                    Buka website live
                  </a>
                  {
                    liveStatus === "temporarily-offline" && (
                      <p class="mt-1.5 text-xs leading-relaxed text-slate-400">
                        Catatan: situs ini sedang dinonaktifkan sementara oleh klien — link tetap kami sertakan sebagai referensi proyek.
                      </p>
                    )
                  }
                </li>
              )
            }
            {
              repoUrl && (
                <li>
                  <a
                    href={repoUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 font-bold text-slate-200 hover:text-white"
                  >
                    <Icon name="external-link" class="h-4 w-4" />
                    Lihat source code (GitHub)
                  </a>
                </li>
              )
            }
            <li class="text-slate-400">
              <strong class="font-semibold text-slate-200">Klien:</strong> {client}
            </li>
          </ul>
        </aside>
      </div>
    </div>
  </article>

  <!-- Proyek lain -->
  <section class="border-t border-line bg-slate-50 py-16 lg:py-24">
    <div class="wrap">
      <h2 class="title text-[clamp(1.9rem,3.6vw,2.8rem)] text-slate-900">Proyek lainnya<span class="pix" aria-hidden="true"></span></h2>
      <div class="stagger mt-12 grid gap-x-6 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
        {others.map((p) => <ProjectCard project={p} />)}
      </div>
    </div>
  </section>
</BaseLayout>
