---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import CtaBanner from "../../components/CtaBanner.astro";

// Urutan: proyek klien dulu (bukti utama untuk calon klien), lalu tahun terbaru.
const projects = (await getCollection("projects")).sort(
  (a, b) => (a.data.internalLabel ? 1 : 0) - (b.data.internalLabel ? 1 : 0) || b.data.year - a.data.year,
);
---

<BaseLayout
  title="Portfolio — Website & Aplikasi yang Telah Dibuat"
  description="Contoh karya Pixcode Studio: website jasa, platform booking, katalog tour, hingga aplikasi chat berenkripsi. Semua proyek klien menyertakan link yang bisa dibuka langsung."
  active="portfolio"
>
  <section class="border-b border-slate-100 bg-slate-50 py-14 lg:py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <p class="text-xs font-bold uppercase tracking-widest text-brand-600">Portfolio</p>
      <h1 class="mt-3 max-w-3xl text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl">
        Karya yang bisa kamu buka sendiri
      </h1>
      <p class="mt-4 max-w-3xl text-lg leading-relaxed text-slate-600">
        Enam proyek terpilih — dari website company profile sampai aplikasi web berenkripsi end-to-end.
        Nama klien kami jaga privasinya, tapi semua website klien ada link live-nya untuk dites langsung.
      </p>
    </div>
  </section>

  <section class="py-16 lg:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <!-- Filter kategori: radio + :checked sibling (CSS murni karena cukup; boleh diganti
           JS jika terbukti lebih optimal — lihat kebijakan §3 AGENTS.md). -->
      <input type="radio" id="filter-semua" name="filter" class="peer-fx sr-only" checked />
      <input type="radio" id="filter-website" name="filter" class="peer-fx sr-only" />
      <input type="radio" id="filter-web-app" name="filter" class="peer-fx sr-only" />

      <div class="flex flex-wrap gap-2" role="group" aria-label="Filter kategori proyek">
        <label for="filter-semua" class="filter-btn cursor-pointer rounded-full border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-600 transition-colors hover:border-brand-500 hover:text-brand-700 has-[:checked]:border-brand-600 has-[:checked]:bg-brand-600 has-[:checked]:text-white">Semua</label>
        <label for="filter-website" class="filter-btn cursor-pointer rounded-full border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-600 transition-colors hover:border-brand-500 hover:text-brand-700 has-[:checked]:border-brand-600 has-[:checked]:bg-brand-600 has-[:checked]:text-white">Website</label>
        <label for="filter-web-app" class="filter-btn cursor-pointer rounded-full border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-600 transition-colors hover:border-brand-500 hover:text-brand-700 has-[:checked]:border-brand-600 has-[:checked]:bg-brand-600 has-[:checked]:text-white">Web App</label>
      </div>

      <div class="reveal mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          projects.map((p) => (
            <div
              class:list={[
                "project-item",
                p.data.category === "website" && "cat-website",
                p.data.category === "web-app" && "cat-web-app",
              ]}
            >
              <ProjectCard project={p} />
            </div>
          ))
        }
      </div>

      <noscript>
        <!-- Filter bekerja sepenuhnya CSS; noscript tidak mengubah apa pun di sini. -->
      </noscript>
    </div>
  </section>

  <style>
    /* Filter berbasis state radio (CSS murni): sembunyikan item yang tidak cocok */
    #filter-website:checked ~ .grid .project-item:not(.cat-website) { display: none; }
    #filter-web-app:checked ~ .grid .project-item:not(.cat-web-app) { display: none; }
  </style>

  <section class="pb-20">
    <CtaBanner
      title="Mau hasil seperti ini untuk usaha kamu?"
      subtitle="Lihat yang paling mirip kebutuhan kamu, lalu tanya via WhatsApp — kami jelaskan cara mencapainya."
    />
  </section>
</BaseLayout>
