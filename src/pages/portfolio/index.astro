---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import CtaBanner from "../../components/CtaBanner.astro";
import PageHero from "../../components/PageHero.astro";

// Urutan: proyek klien dulu (bukti utama untuk calon klien), lalu tahun terbaru.
const projects = (await getCollection("projects")).sort(
  (a, b) => (a.data.internalLabel ? 1 : 0) - (b.data.internalLabel ? 1 : 0) || b.data.year - a.data.year,
);
---

<BaseLayout
  title="Portfolio — Website & Aplikasi yang Telah Dibuat"
  description="Contoh karya Pixcode Studio: website jasa, platform booking, katalog tour, hingga aplikasi chat berenkripsi. Website klien yang sedang aktif bisa dibuka langsung lewat link-nya."
  active="portfolio"
>
  <PageHero kicker="Portfolio" title="Karya yang bisa kamu buka sendiri">
    <p class="text-slate-600">
      {projects.length} proyek terpilih, dari website company profile sampai aplikasi web berenkripsi end-to-end.
      Nama klien kami jaga privasinya; website klien yang sedang aktif bisa kamu buka langsung lewat link-nya.
    </p>
  </PageHero>

  <section class="py-16 lg:py-24">
    <div class="wrap">
      <h2 class="sr-only">Daftar proyek</h2>
      <!-- Filter kategori: radio + :checked sibling (CSS murni karena cukup; boleh diganti
           JS jika terbukti lebih optimal — lihat kebijakan §3 AGENTS.md). -->
      <input type="radio" id="filter-semua" name="filter" class="peer-fx sr-only" checked />
      <input type="radio" id="filter-website" name="filter" class="peer-fx sr-only" />
      <input type="radio" id="filter-web-app" name="filter" class="peer-fx sr-only" />

      <div class="flex flex-wrap gap-2" role="group" aria-label="Filter kategori proyek">
        {
          [
            ["filter-semua", "Semua"],
            ["filter-website", "Website"],
            ["filter-web-app", "Web App"],
          ].map(([id, label]) => (
            <label
              for={id}
              class="btn-press cursor-pointer rounded-xl border border-line px-5 py-2.5 text-sm font-bold text-slate-600 hover:border-brand-500 hover:text-brand-700"
              data-filter={id}
            >
              {label}
            </label>
          ))
        }
      </div>

      <div class="stagger mt-12 grid gap-x-6 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
        {
          projects.map((p, i) => (
            <div
              style={`--i:${i}`}
              class:list={[
                "project-item",
                p.data.category === "website" && "cat-website",
                p.data.category === "web-app" && "cat-web-app",
              ]}
            >
              <ProjectCard project={p} />
            </div>
          ))
        }
      </div>

      <noscript>
        <!-- Filter bekerja sepenuhnya CSS; noscript tidak mengubah apa pun di sini. -->
      </noscript>
    </div>
  </section>

  <style>
    /* Filter berbasis state radio (CSS murni): sembunyikan item yang tidak cocok */
    #filter-semua:checked ~ div [data-filter="filter-semua"],
    #filter-website:checked ~ div [data-filter="filter-website"],
    #filter-web-app:checked ~ div [data-filter="filter-web-app"] {
      background: var(--color-ink);
      border-color: var(--color-ink);
      color: #fff;
    }
    #filter-website:checked ~ .grid .project-item:not(.cat-website) { display: none; }
    #filter-web-app:checked ~ .grid .project-item:not(.cat-web-app) { display: none; }
  </style>

  <CtaBanner
    title="Mau hasil seperti ini untuk usaha kamu?"
    subtitle="Lihat yang paling mirip kebutuhan kamu, lalu tanya via WhatsApp. Kami jelaskan cara mencapainya."
  />
</BaseLayout>
