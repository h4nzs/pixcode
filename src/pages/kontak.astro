---
import BaseLayout from "../layouts/BaseLayout.astro";
import WaButton from "../components/WaButton.astro";
import Icon from "../components/Icon.astro";
import { site, waLink } from "../data/site";
---

<BaseLayout
  title="Kontak — Konsultasi Gratis via WhatsApp"
  description={`Hubungi Pixcode Studio ${site.city}: WhatsApp ${site.whatsapp} atau email ${site.email}. Konsultasi gratis, dibalas cepat di jam kerja.`}
  active="kontak"
>
  <section class="py-14 lg:py-20">
    <div class="mx-auto max-w-4xl px-4 sm:px-6">
      <p class="text-xs font-bold uppercase tracking-widest text-brand-600">Kontak</p>
      <h1 class="mt-3 text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl">
        Obrolan pertama, tanpa komitmen
      </h1>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-slate-600">
        Ceritakan usaha kamu dan apa yang ingin dicapai. Kami balas dengan pertanyaan yang tepat —
        dan rekomendasi paket yang jujur, bukan yang paling mahal.
      </p>

      <div class="mt-10 grid gap-6 sm:grid-cols-2">
        <!-- Kartu WA utama -->
        <div class="rounded-2xl border-2 border-wa/30 bg-white p-6 shadow-sm sm:col-span-2">
          <div class="flex flex-wrap items-center justify-between gap-4">
            <div>
              <h2 class="flex items-center gap-2 text-lg font-bold text-slate-900">
                <Icon name="message-circle" class="h-5 w-5 text-wa" />
                WhatsApp — kanal tercepat
              </h2>
              <p class="mt-1 text-sm text-slate-600">
                {site.city} & sekitarnya. Konsultasi awal gratis, tanpa DP.
              </p>
            </div>
            <WaButton size="large" label={`Chat ${site.whatsapp.slice(2).replace(/(\d{3})(\d{3})(\d+)/, "$1-$2-$3")}`} />
          </div>
        </div>

        <!-- Email -->
        <a
          href={`mailto:${site.email}`}
          class="rounded-2xl border border-slate-200 p-6 shadow-sm transition-colors hover:border-brand-500"
        >
          <h2 class="flex items-center gap-2 font-bold text-slate-900">
            <Icon name="mail" class="h-5 w-5 text-brand-600" />
            Email
          </h2>
          <p class="mt-2 text-sm text-slate-600">{site.email}</p>
          <p class="mt-1 text-xs text-slate-400">Untuk dokumen, brief, atau penawaran resmi.</p>
        </a>

        <!-- Jam & area -->
        <div class="rounded-2xl border border-slate-200 p-6 shadow-sm">
          <h2 class="flex items-center gap-2 font-bold text-slate-900">
            <Icon name="clock" class="h-5 w-5 text-brand-600" />
            Jam respons
          </h2>
          <p class="mt-2 text-sm text-slate-600">Senin–Sabtu, 09.00–17.00 WIB</p>
          <p class="mt-1 flex items-start gap-1.5 text-xs text-slate-400">
            <Icon name="map-pin" class="mt-0.5 h-3.5 w-3.5 shrink-0" />
            Basis {site.city} — melayani {site.areasServed.join(", ")} & sekitarnya.
          </p>
        </div>
      </div>

      <p class="mt-8 text-sm text-slate-500">
        {/* IG menyusul — TODO(user): tambahkan link Instagram saat akun dibuat (docs checklist #2). */}
        Lebih suka email? Kirim brief singkat usaha kamu — kami balas dengan estimasi paket & harga.
      </p>
    </div>
  </section>
</BaseLayout>
