---
// Layout dasar: <head> SEO lengkap + Header + Footer + reveal-on-scroll (vanilla, ringan —
// sesuai kebijakan §3 AGENTS.md: zero-JS default, JS boleh jika lebih optimal).
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import AnalyticsBeacon from "../components/AnalyticsBeacon.astro";
import { site, fullUrl } from "../data/site";
import "../styles/global.css";

interface Props {
  title: string; // tanpa suffix — suffix ditambahkan otomatis
  description?: string;
  active?: "home" | "layanan" | "portfolio" | "tentang" | "kontak";
  /** JSON-LD tambahan per halaman (objek atau array objek). */
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description = site.description, active, schema } = Astro.props;
// Suffix pendek agar title tidak terpotong Google & tidak duplikat keyword halaman Home.
const fullTitle = `${title} | ${site.name}`;
const canonical = fullUrl(Astro.url.pathname);
const ogImage = fullUrl("/og-image.png");
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- View Transitions: morph halus antar halaman (0 KB custom JS — bawaan Astro). -->
    <ClientRouter />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph / WhatsApp / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Font via Astro Fonts API (self-host, fallback + preload otomatis) -->
    <Font cssVariable="--font-jakarta" preload />

    <!-- JSON-LD: ProfessionalService global (entity: nama/WA/kota/area konsisten — riset §6) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ProfessionalService",
      name: site.name,
      description: site.description,
      url: site.url,
      image: ogImage,
      logo: fullUrl("/favicon.svg"),
      telephone: `+${site.whatsapp}`,
      email: site.email,
      foundingDate: String(site.foundedYear),
      address: { "@type": "PostalAddress", addressLocality: site.city, addressRegion: site.region, addressCountry: "ID" },
      // Pola hibrida: daftar City (basis + kota besar) UNTUK sinyal lokal, plus Country
      // untuk cakupan nasional — keduanya valid sebagai array areaServed (schema.org Place).
      areaServed: [
        ...[site.city, ...site.majorCities].map((name) => ({ "@type": "City", name })),
        { "@type": "Country", name: site.country },
      ],
      sameAs: [
        ...(site.instagram ? [`https://instagram.com/${site.instagram}`] : []),
        "https://github.com/h4nzs",
      ],
      priceRange: "Mulai Rp 400.000",
    })} />

    {schema && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(schema)}
      />
    )}

    <!-- Cloudflare Web Analytics (cookieless) — juga dipakai halaman /wa. -->
    <AnalyticsBeacon />
  </head>

  <body>
    <a
      href="#konten"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[60] focus:rounded-lg focus:bg-brand-600 focus:px-4 focus:py-2 focus:text-white"
    >
      Lewati ke konten utama
    </a>

    <Header active={active} />

    <main id="konten">
      <slot />
    </main>

    <Footer />

    <!-- Reveal + stagger on scroll — vanilla & ringan; di-init ulang pada navigasi
         View Transitions (astro:page-load). Nonaktif jika prefers-reduced-motion. -->
    <script>
      const prefersReduced = () => window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      function initReveal() {
        // Amati keduanya: .reveal (elemen tunggal) & .stagger (container — anaknya yang dianimasikan).
        const els = document.querySelectorAll<HTMLElement>(".reveal:not([data-rv]), .stagger:not([data-rv])");
        if (prefersReduced()) {
          els.forEach((el) => el.classList.add("is-visible"));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add("is-visible");
                io.unobserve(e.target);
              }
            }
          },
          { threshold: 0.12 },
        );
        els.forEach((el) => {
          el.dataset.rv = "1";
          io.observe(el);
        });
      }

      initReveal();
      document.addEventListener("astro:page-load", initReveal);
    </script>
  </body>
</html>
