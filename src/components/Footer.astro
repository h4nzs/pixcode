---
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import { site, waLink } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="bg-slate-900 text-slate-300">
  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <div class="grid gap-10 md:grid-cols-3">
      <div>
        <Logo class="h-8" useWhite />
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-slate-400">
          {site.tagline}
        </p>
      </div>

      <nav aria-label="Navigasi footer">
        <h3 class="text-sm font-semibold uppercase tracking-wider text-slate-400">Navigasi</h3>
        <ul class="mt-4 space-y-2 text-sm">
          <li><a class="hover:text-white" href="/">Home</a></li>
          <li><a class="hover:text-white" href="/layanan/">Layanan & Harga</a></li>
          <li><a class="hover:text-white" href="/portfolio/">Portfolio</a></li>
          <li><a class="hover:text-white" href="/tentang/">Tentang</a></li>
          <li><a class="hover:text-white" href="/kontak/">Kontak</a></li>
        </ul>
        <ul class="mt-6 space-y-2 border-t border-white/10 pt-4 text-xs text-slate-500">
          <li><a class="hover:text-slate-300" href="/kebijakan-privasi/">Kebijakan Privasi</a></li>
          <li><a class="hover:text-slate-300" href="/syarat-ketentuan/">Syarat & Ketentuan</a></li>
        </ul>
      </nav>

      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-slate-400">Kontak</h3>
        <ul class="mt-4 space-y-3 text-sm">
          <li>
            <a
              class="inline-flex items-center gap-2 font-medium text-brand-300 hover:text-brand-200"
              href={waLink({ type: "general" })}
              target="_blank"
              rel="noopener noreferrer"
            >
              <Icon name="message-circle" class="h-4 w-4" />
              +62 815-1313-5408 (WhatsApp)
            </a>
          </li>
          <li>
            <a class="inline-flex items-center gap-2 hover:text-white" href={`mailto:${site.email}`}>
              <Icon name="mail" class="h-4 w-4" />
              {site.email}
            </a>
          </li>
          <li class="inline-flex items-center gap-2">
            <Icon name="map-pin" class="h-4 w-4" />
            {site.city}, {site.region} — melayani {site.areasServed.join(", ")}
          </li>
          {
            site.instagram && (
              <li>
                <a
                  class="inline-flex items-center gap-2 hover:text-white"
                  href={`https://instagram.com/${site.instagram}`}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Instagram: @{site.instagram}
                </a>
              </li>
            )
          }
        </ul>
      </div>
    </div>

    <div class="mt-12 border-t border-white/10 pt-6 text-xs text-slate-500">
      © {year} {site.name}. Dibuat dengan Astro — cepat di jaringan apapun.
    </div>
  </div>
</footer>
