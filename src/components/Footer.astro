---
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import BigWordmark from "./BigWordmark.astro";
import { site, waDisplay } from "../data/site";

const year = new Date().getFullYear();

const columns = [
  {
    title: "Layanan",
    links: [
      { label: "Paket & harga", href: "/layanan/" },
      { label: "Portfolio", href: "/portfolio/" },
      { label: "Contoh template", href: "/template/" },
      { label: "Konsultasi", href: "/kontak/" },
    ],
  },
  {
    title: "Studio",
    links: [
      { label: "Tentang", href: "/tentang/" },
      { label: "Kebijakan privasi", href: "/kebijakan-privasi/" },
      { label: "Syarat & ketentuan", href: "/syarat-ketentuan/" },
    ],
  },
];
---

<footer class="reveal bg-ink text-slate-300">
  <div class="wrap pt-16 lg:pt-20">
    <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-[1.6fr_1fr_1fr_1.4fr]">
      <div>
        <Logo class="h-10" full useWhite />
        <p class="mt-5 max-w-xs text-[0.95rem] leading-relaxed text-slate-300">
          {site.tagline}
        </p>
        <p class="mt-5 inline-flex items-center gap-2 text-sm text-slate-300">
          <Icon name="map-pin" class="h-4 w-4 shrink-0 text-brand-400" />
          {site.city}, {site.region}
        </p>
      </div>

      {
        columns.map((col) => (
          <nav aria-label={`Navigasi ${col.title}`}>
            <h2 class="text-sm font-bold text-white">{col.title}</h2>
            <ul class="mt-5 space-y-3 text-[0.95rem]">
              {col.links.map((link) => (
                <li>
                  <a class="text-slate-300 transition-colors hover:text-white" href={link.href}>
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }

      <div>
        <h2 class="text-sm font-bold text-white">Hubungi</h2>
        <ul class="mt-5 space-y-3.5 text-[0.95rem]">
          <li>
            <a
              class="inline-flex items-center gap-2 font-bold text-brand-300 transition-colors hover:text-white"
              href="/wa/umum/"
              target="_blank"
              rel="noopener noreferrer"
            >
              <Icon name="message-circle" class="h-4 w-4" />
              {waDisplay}
            </a>
          </li>
          <li>
            <a class="inline-flex items-center gap-2 text-slate-300 transition-colors hover:text-white" href={`mailto:${site.email}`}>
              <Icon name="mail" class="h-4 w-4" />
              {site.email}
            </a>
          </li>
          <li class="flex items-start gap-2 text-slate-300">
            <Icon name="clock" class="mt-0.5 h-4 w-4 shrink-0" />
            {site.hours}
          </li>
          {
            site.instagram && (
              <li>
                <a
                  class="inline-flex items-center gap-2 text-slate-300 transition-colors hover:text-white"
                  href={`https://instagram.com/${site.instagram}`}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Instagram: @{site.instagram}
                </a>
              </li>
            )
          }
        </ul>
      </div>
    </div>

    <div class="mt-14 flex flex-col gap-2 border-t border-white/10 pt-6 text-xs text-slate-400 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {site.name}. Semua hak dilindungi.</p>
      <p>Dibuat dan dirawat dari {site.city}, melayani {site.serviceArea}.</p>
    </div>
  </div>

  <div class="wrap mt-10 pb-0">
    <BigWordmark />
  </div>
</footer>
