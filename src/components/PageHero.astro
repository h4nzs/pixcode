---
import { markBlocks } from "../data/brand";

interface Props {
  kicker: string;
  title: string;
  /** Latar: terang (paper) atau gelap (Ink). */
  dark?: boolean;
}
const { kicker, title, dark = false } = Astro.props;
---

<!-- Kepala halaman dalam: judul besar bertitik kotak, dan mark kecil yang "naik" di kanan sebagai penanda merek. -->
<section class:list={["relative overflow-hidden border-b", dark ? "border-white/10 bg-ink" : "border-line bg-slate-50"]}>
  <svg
    class="parallax-slow pointer-events-none absolute -right-8 top-1/2 hidden h-[22rem] w-[22rem] -translate-y-1/2 md:block lg:right-[4%]"
    viewBox="0 0 32 32"
    aria-hidden="true"
  >
    {
      markBlocks.map((b) => (
        <rect
          x={b.x}
          y={b.y}
          width={b.w}
          height={b.h}
          rx={b.rx}
          fill={b.anchor ? (dark ? "#14b8a6" : "#0f172a") : dark ? "#134e4a" : "#ccfbf1"}
        />
      ))
    }
  </svg>

  <div class="wrap relative py-16 lg:py-24">
    <p class:list={["hero-seq flex items-center gap-2.5 text-sm font-bold", dark ? "text-brand-300" : "text-brand-600"]} style="--d:0">
      <span class="h-2.5 w-2.5 rounded-[3px] bg-brand-500" aria-hidden="true"></span>
      {kicker}
    </p>
    <h1 class:list={["display mt-5 max-w-4xl text-[clamp(2.4rem,5.4vw,4.6rem)]", dark ? "!text-white" : ""]}>
      <span class="line"><span style="--d:0">{title}<span class:list={["pix", dark && "pix-light"]} aria-hidden="true"></span></span></span>
    </h1>
    <div class="hero-seq mt-6 max-w-2xl text-lg leading-relaxed" style="--d:1">
      <slot />
    </div>
  </div>
</section>
