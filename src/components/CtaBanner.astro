---
import Icon from "./Icon.astro";
import { markBlocks } from "../data/brand";

interface Props {
  title?: string;
  subtitle?: string;
}
const {
  title = "Mulai dengan obrolan ringan",
  subtitle = "Ceritakan usaha kamu, kami bantu pilih paket yang paling pas. Belum ada komitmen, belum ada DP.",
} = Astro.props;
---

<section class="relative overflow-hidden bg-brand-600">
  <!-- Mark sebagai watermark besar: tiga blok teal terang dan satu jangkar gelap, terpotong di tepi. -->
  <svg
    class="pointer-events-none absolute right-[6%] top-1/2 hidden h-[26rem] w-[26rem] -translate-y-1/2 lg:block"
    viewBox="0 0 32 32"
    aria-hidden="true"
  >
    {
      markBlocks.map((b) => (
        <rect x={b.x} y={b.y} width={b.w} height={b.h} rx={b.rx} fill={b.anchor ? "#134e4a" : "#14b8a6"} />
      ))
    }
  </svg>

  <div class="wrap relative py-20 lg:py-28">
    <h2 class="display max-w-4xl text-[clamp(2.4rem,6vw,5rem)] text-white">{title}<span class="pix pix-light" aria-hidden="true"></span></h2>
    <p class="mt-6 max-w-xl text-lg leading-relaxed text-brand-100">{subtitle}</p>
    <div class="mt-10 flex flex-wrap items-center gap-4">
      <a
        href="/wa/umum/"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-press inline-flex items-center justify-center gap-2.5 rounded-xl bg-wa px-7 py-4 text-base font-bold text-slate-900 hover:bg-wa-dark focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-white"
      >
        <Icon name="message-circle" class="h-5 w-5" />
        Tanya dulu via WhatsApp, gratis
      </a>
      <a href="/layanan/" class="btn-press inline-flex items-center gap-2 px-2 py-3 font-bold text-white underline decoration-white/40 underline-offset-8 hover:decoration-white">
        Lihat paket dan harga
        <Icon name="arrow-right" class="arrow h-5 w-5" />
      </a>
    </div>
  </div>
</section>
