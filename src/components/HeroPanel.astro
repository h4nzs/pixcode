---
// Satu panel gambar besar untuk hero. Sudut kiri-bawahnya dipotong berundak (tiga anak tangga, seperti mark),
// isinya bergantian pelan antara dua karya nyata dan satu contoh template. Chip Ink di pojok kanan-bawah
// adalah "jangkar" dari mark: harga paket UMKM. Gerak hanya crossfade CSS dan berhenti saat reduced-motion.
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { projectImage } from "../utils/projectImage";
import { templateImage } from "../utils/templateImage";

interface Props {
  top: CollectionEntry<"projects">;
  mid: CollectionEntry<"projects">;
}
const { top, mid } = Astro.props;

const slides = [
  { img: projectImage(top.data.thumbnail), alt: `Karya: ${top.data.title}`, caption: `Karya: ${top.data.title}`, pos: "object-[22%_0%]" },
  { img: projectImage(mid.data.thumbnail), alt: `Karya: ${mid.data.title}`, caption: `Karya: ${mid.data.title}`, pos: "object-[22%_0%]" },
  { img: templateImage("bengkel.png"), alt: "Contoh template Paket UMKM: Bengkel", caption: "Contoh template: Bengkel", pos: "object-[22%_0%]" },
];
---

<!-- Mobile: blok di bawah teks. Desktop: menempel di sisi kanan kartu, penuh dari atas sampai bawah. -->
<div class="hero-panel relative h-[19rem] sm:h-[26rem] lg:absolute lg:inset-y-0 lg:right-0 lg:h-auto lg:w-1/2">
  <div class="hp-clip absolute inset-0 overflow-hidden bg-slate-200">
    {
      slides.map((s, i) => (
        <figure class="hp-slide absolute inset-0 m-0" style={`--i:${i}`}>
          <Image
            src={s.img}
            alt={s.alt}
            width={1200}
            height={1100}
            loading="eager"
            fetchpriority={i === 0 ? "high" : "auto"}
            class:list={["h-full w-full object-cover", s.pos]}
          />
          <figcaption class="absolute bottom-4 left-4 rounded-lg bg-white/95 px-3 py-1.5 text-xs font-bold text-slate-900 sm:bottom-6 sm:left-6 sm:text-sm lg:bottom-auto lg:left-auto lg:right-6 lg:top-6">
            {s.caption}
          </figcaption>
        </figure>
      ))
    }
  </div>

  <a
    href="/layanan/#paket"
    class="btn-press absolute bottom-4 right-4 rounded-2xl bg-ink px-5 py-4 text-white shadow-[0_18px_30px_-14px_rgb(2_23_22/0.6)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-600 sm:bottom-6 sm:right-6 sm:px-6 sm:py-5"
    aria-label="Paket UMKM mulai Rp 400.000, lihat paket dan harga"
  >
    <span class="block text-xs font-semibold text-brand-300 sm:text-sm">Paket UMKM</span>
    <span class="display mt-1 block text-2xl sm:text-3xl"><span class="mr-1.5 text-sm font-bold text-slate-400 sm:text-base">Rp</span>400.000</span>
  </a>
</div>
