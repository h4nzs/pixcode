---
// Satu panel gambar besar untuk hero. Sudut kiri-bawahnya dipotong berundak (tiga anak tangga, seperti mark),
// isinya bergantian pelan antara dua karya nyata dan satu contoh template. Chip Ink di pojok kanan-bawah
// adalah "jangkar" dari mark: harga paket UMKM. Gerak hanya crossfade CSS dan berhenti saat reduced-motion.
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { projectImage } from "../utils/projectImage";
import { templateImage } from "../utils/templateImage";

interface Props {
  top: CollectionEntry<"projects">;
  mid: CollectionEntry<"projects">;
}
const { top, mid } = Astro.props;

const slides = [
  { img: projectImage(top.data.thumbnail), alt: `Karya: ${top.data.title}`, caption: `Karya: ${top.data.title}`, pos: "object-left-top" },
  { img: projectImage(mid.data.thumbnail), alt: `Karya: ${mid.data.title}`, caption: `Karya: ${mid.data.title}`, pos: "object-left-top" },
  { img: templateImage("bengkel.png"), alt: "Contoh template Paket UMKM: Bengkel", caption: "Contoh template: Bengkel", pos: "object-left-top" },
];
---

<div class="hero-panel relative">
  <div class="hp-clip relative aspect-[5/4] overflow-hidden rounded-[1.5rem] bg-slate-200 sm:rounded-[2rem]">
    {
      slides.map((s, i) => (
        <figure class="hp-slide absolute inset-0 m-0" style={`--i:${i}`}>
          <Image
            src={s.img}
            alt={s.alt}
            width={1000}
            height={800}
            loading="eager"
            fetchpriority={i === 0 ? "high" : "auto"}
            class:list={["h-full w-full object-cover", s.pos]}
          />
          <figcaption class="absolute left-4 top-4 rounded-lg bg-white/95 px-3 py-1.5 text-xs font-bold text-slate-900 sm:left-6 sm:top-6 sm:text-sm">
            {s.caption}
          </figcaption>
        </figure>
      ))
    }
  </div>

  <a
    href="/layanan/#paket"
    class="btn-press absolute -bottom-3 right-3 rounded-2xl bg-ink px-5 py-4 text-white shadow-[0_18px_30px_-14px_rgb(2_23_22/0.6)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-600 sm:right-6 sm:px-6 sm:py-5"
    aria-label="Paket UMKM mulai Rp 400.000, lihat paket dan harga"
  >
    <span class="block text-xs font-semibold text-brand-300 sm:text-sm">Paket UMKM</span>
    <span class="display mt-1 block text-2xl sm:text-3xl"><span class="mr-1.5 text-sm font-bold text-slate-400 sm:text-base">Rp</span>400.000</span>
  </a>
</div>
