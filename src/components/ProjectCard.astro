---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { packages } from "../data/packages";
import { projectImage } from "../utils/projectImage";

interface Props {
  project: CollectionEntry<"projects">;
  /** Index dalam grid stagger — mengatur delay animasi masuk (opsional). */
  index?: number;
}
const { project, index } = Astro.props;
const { title, client, category, package: pkgId, internalLabel, year, thumbnail, liveStatus } = project.data;
const thumb = projectImage(thumbnail);

const pkgName = pkgId ? packages.find((p) => p.id === pkgId)?.name : undefined;
const categoryLabel = { website: "Website", "web-app": "Web App", pos: "POS" }[category];
---

<a
  href={`/portfolio/${project.id}/`}
  style={index !== undefined ? `--i:${index}` : undefined}
  class:list={["group block overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm", "card-lift stagger-child"]}
>
  <div class="overflow-hidden">
    <Image
      src={thumb}
      alt={`Tampilan ${title}`}
      width={600}
      height={450}
      loading="lazy"
      class="aspect-[4/3] w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
    />
  </div>
  <div class="p-5">
    <div class="flex items-center justify-between gap-2 text-xs">
      <div class="flex items-center gap-1.5">
        <span class="rounded-md bg-brand-50 px-2 py-0.5 font-semibold text-brand-700">{categoryLabel}</span>
        {
          liveStatus === "temporarily-offline" && (
            <span class="rounded-md bg-amber-50 px-2 py-0.5 font-semibold text-amber-700">Nonaktif sementara</span>
          )
        }
      </div>
      <span class="text-slate-400">{year}</span>
    </div>
    <h3 class="mt-3 font-bold text-slate-900 group-hover:text-brand-700">{title}</h3>
    <p class="mt-1 text-sm text-slate-500">
      {internalLabel ? <span class="italic text-slate-400">{internalLabel}</span> : client}
      {pkgName && <span class="mx-1.5 text-slate-300">·</span>}
      {pkgName && <span>Paket {pkgName}</span>}
    </p>
  </div>
</a>
