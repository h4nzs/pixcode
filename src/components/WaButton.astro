---
// CTA utama seluruh situs (riset §2: warm action). Nomor & template pesan dari src/data/site.ts.
import Icon from "./Icon.astro";
import { waLink, type WaContext } from "../data/site";

interface Props {
  /** Default: { type: "general" } jika tidak diberikan. */
  context?: WaContext;
  /** primary = hijau WhatsApp; ghost = garis di latar terang; dark = garis di latar gelap. */
  variant?: "primary" | "ghost" | "dark";
  size?: "normal" | "large";
  label?: string;
  /** Pakai redirect terukur /wa/[slug] (pageview Web Analytics CF) — default true. */
  tracked?: boolean;
  class?: string;
}

const {
  context = { type: "general" } as WaContext,
  variant = "primary",
  size = "normal",
  label,
  tracked = true,
  class: className = "",
} = Astro.props;

const directUrl = waLink(context);
// Halaman vanity /wa/<konteks>/ dibuat saat build (src/pages/wa/[slug].astro) —
// pageview-nya jadi metrik klik WA di Cloudflare Web Analytics.
const trackSlug =
  context.type === "package"
    ? `paket-${context.packageName.replace("Paket ", "").toLowerCase().replace(/[^a-z0-9]+/g, "-")}`
    : context.type === "project"
      ? "portfolio"
      : context.type === "template"
        ? `template-${context.slug}`
        : "umum";
const href = tracked ? `/wa/${trackSlug}/` : directUrl;

const base =
  "btn-press inline-flex items-center justify-center gap-2.5 rounded-xl font-bold focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-brand-600";
const sizes = size === "large" ? "px-7 py-4 text-base" : "px-5 py-2.5 text-sm";
const variants = {
  primary: "bg-wa text-slate-900 hover:bg-wa-dark",
  ghost: "border border-slate-300 text-slate-900 hover:border-slate-900",
  dark: "border border-white/30 text-white hover:border-white hover:bg-white/5",
};
---

<a href={href} target="_blank" rel="noopener noreferrer" class={`${base} ${sizes} ${variants[variant]} ${className}`}>
  <Icon name="message-circle" class="h-5 w-5" />
  {label ?? "Tanya via WhatsApp"}
</a>
