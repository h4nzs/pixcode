---
interface Props {
  kicker?: string;
  title: string;
  subtitle?: string;
  center?: boolean;
}
const { kicker, title, subtitle, center = false } = Astro.props;
---

<div class={`${center ? "mx-auto max-w-2xl text-center" : "max-w-2xl"}`}>
  {
    kicker && (
      <p class="text-xs font-bold uppercase tracking-widest text-brand-600">
        <span class="mr-2 inline-block h-2 w-2 rounded-sm bg-brand-500 align-middle" aria-hidden="true" />
        {kicker}
      </p>
    )
  }
  <h2 class="mt-3 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">{title}</h2>
  {subtitle && <p class="mt-4 text-base leading-relaxed text-slate-600">{subtitle}</p>}
</div>
