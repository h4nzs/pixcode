---
interface Props {
  /** Penanda kecil di atas judul. Opsional; dipakai hemat. */
  kicker?: string;
  title: string;
  subtitle?: string;
  center?: boolean;
  /** Untuk latar gelap. */
  dark?: boolean;
}
const { kicker, title, subtitle, center = false, dark = false } = Astro.props;
---

<div class={center ? "mx-auto max-w-3xl text-center" : "max-w-3xl"}>
  {
    kicker && (
      <p class={`flex items-center gap-2.5 text-sm font-bold ${center ? "justify-center" : ""} ${dark ? "text-brand-300" : "text-brand-600"}`}>
        <span class={`h-2.5 w-2.5 rounded-[3px] ${dark ? "bg-brand-400" : "bg-brand-500"}`} aria-hidden="true" />
        {kicker}
      </p>
    )
  }
  <h2 class={`title text-[clamp(2.1rem,4.6vw,3.6rem)] ${kicker ? "mt-4" : ""} ${dark ? "text-white" : "text-slate-900"}`}>{title}</h2>
  {subtitle && <p class={`mt-5 max-w-2xl text-lg leading-relaxed ${center ? "mx-auto" : ""} ${dark ? "text-slate-300" : "text-slate-600"}`}>{subtitle}</p>}
</div>
