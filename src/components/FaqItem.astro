---
import Icon from "./Icon.astro";

interface Props {
  question: string;
  answer: string;
}
const { question, answer } = Astro.props;
---

<details class="group rounded-xl border border-slate-200 bg-white px-5 py-4 transition-colors duration-300 hover:border-brand-200 [&_summary::-webkit-details-marker]:hidden">
  <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-slate-900">
    {question}
    <Icon name="chevron-down" class="h-5 w-5 shrink-0 text-slate-400 transition-transform duration-300 group-open:rotate-180" />
  </summary>
  <!-- Panel halus: grid 0fr→1fr saat <details> terbuka (murni CSS — lihat global.css). -->
  <div class="faq-panel">
    <div>
      <p class="pt-3 text-sm leading-relaxed text-slate-600">{answer}</p>
    </div>
  </div>
</details>
