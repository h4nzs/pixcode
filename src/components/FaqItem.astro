---
import Icon from "./Icon.astro";

interface Props {
  question: string;
  answer: string;
}
const { question, answer } = Astro.props;
---

<details class="group rounded-xl border border-slate-200 bg-white px-5 py-4 [&_summary::-webkit-details-marker]:hidden">
  <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-slate-900">
    {question}
    <Icon name="chevron-down" class="h-5 w-5 shrink-0 text-slate-400 transition-transform group-open:rotate-180" />
  </summary>
  <p class="mt-3 text-sm leading-relaxed text-slate-600">{answer}</p>
</details>
