---
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import { waLink } from "../data/site";

interface Props {
  active?: "home" | "layanan" | "portfolio" | "tentang" | "kontak";
}
const { active } = Astro.props;

const nav = [
  { href: "/", key: "home", label: "Home" },
  { href: "/layanan/", key: "layanan", label: "Layanan" },
  { href: "/portfolio/", key: "portfolio", label: "Portfolio" },
  { href: "/tentang/", key: "tentang", label: "Tentang" },
  { href: "/kontak/", key: "kontak", label: "Kontak" },
] as const;
---

<header class="sticky top-0 z-50 border-b border-slate-200/70 bg-white/90 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
    <Logo class="h-8" />

    <nav class="hidden items-center gap-1 md:flex" aria-label="Navigasi utama">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={active === item.key ? "page" : undefined}
            class={`rounded-lg px-3 py-2 text-sm font-medium transition-colors ${
              active === item.key
                ? "bg-brand-50 text-brand-700"
                : "text-slate-600 hover:bg-slate-50 hover:text-slate-900"
            }`}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden md:block">
      <a
        href={waLink({ type: "general" })}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-lg bg-wa px-4 py-2 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-wa-dark"
      >
        <Icon name="message-circle" class="h-4 w-4" />
        Konsultasi Gratis
      </a>
    </div>

    <!-- Toggle drawer mobile: checkbox hack (tanpa JS karena cukup & andal; boleh diganti
         pendekatan JS jika terbukti lebih optimal — lihat kebijakan §3 AGENTS.md). -->
    <input type="checkbox" id="nav-toggle" class="peer sr-only" />
    <label
      for="nav-toggle"
      class="flex h-10 w-10 cursor-pointer items-center justify-center rounded-lg text-slate-700 hover:bg-slate-100 md:hidden"
      aria-label="Buka menu navigasi"
    >
      <Icon name="menu" class="h-6 w-6" />
    </label>

    <div
      class="fixed inset-x-0 top-16 z-40 hidden flex-col gap-1 border-b border-slate-200 bg-white p-4 shadow-lg peer-checked:flex md:hidden"
    >
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={active === item.key ? "page" : undefined}
            class={`rounded-lg px-4 py-3 text-base font-medium ${
              active === item.key ? "bg-brand-50 text-brand-700" : "text-slate-700 hover:bg-slate-50"
            }`}
          >
            {item.label}
          </a>
        ))
      }
      <a
        href={waLink({ type: "general" })}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-2 inline-flex items-center justify-center gap-2 rounded-lg bg-wa px-4 py-3 text-base font-semibold text-white"
      >
        <Icon name="message-circle" class="h-5 w-5" />
        Konsultasi Gratis
      </a>
    </div>
  </div>
</header>
