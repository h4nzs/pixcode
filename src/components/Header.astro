---
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";

interface Props {
  active?: "home" | "layanan" | "portfolio" | "tentang" | "kontak";
}
const { active } = Astro.props;

const nav = [
  { href: "/", key: "home", label: "Beranda" },
  { href: "/layanan/", key: "layanan", label: "Layanan" },
  { href: "/portfolio/", key: "portfolio", label: "Portfolio" },
  { href: "/tentang/", key: "tentang", label: "Tentang" },
  { href: "/kontak/", key: "kontak", label: "Kontak" },
] as const;
---

<header class="sticky top-0 z-50 border-b border-line/80 bg-white/85 backdrop-blur-md">
  <div class="wrap flex h-[68px] items-center justify-between">
    <Logo class="h-8" />

    <nav class="hidden items-center gap-1 md:flex" aria-label="Navigasi utama">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={active === item.key ? "page" : undefined}
            class={`nav-link rounded-lg px-3 py-2 text-sm font-semibold transition-colors ${
              active === item.key ? "text-slate-900" : "text-slate-600 hover:text-slate-900"
            }`}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden md:block">
      <a
        href="/wa/umum/"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-press inline-flex items-center gap-2 rounded-xl bg-wa px-4 py-2.5 text-sm font-bold text-slate-900 hover:bg-wa-dark"
      >
        <Icon name="message-circle" class="h-4 w-4" />
        Konsultasi gratis
      </a>
    </div>

    <!-- Drawer mobile: checkbox hack (tanpa JS karena cukup & andal; lihat kebijakan §3 AGENTS.md). -->
    <input type="checkbox" id="nav-toggle" class="peer sr-only" />
    <label
      for="nav-toggle"
      class="flex h-10 w-10 cursor-pointer items-center justify-center rounded-lg text-slate-900 hover:bg-slate-100 peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-brand-600 md:hidden"
    >
      <span class="sr-only">Buka menu navigasi</span>
      <Icon name="menu" class="h-6 w-6" />
    </label>

    <div
      class="fixed inset-x-0 top-[68px] z-40 hidden flex-col gap-1 border-b border-line bg-white p-4 shadow-lg peer-checked:flex md:hidden"
    >
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={active === item.key ? "page" : undefined}
            class={`rounded-xl px-4 py-3 text-lg font-bold ${
              active === item.key ? "bg-brand-100 text-brand-800" : "text-slate-800 hover:bg-slate-50"
            }`}
          >
            {item.label}
          </a>
        ))
      }
      <a
        href="/wa/umum/"
        target="_blank"
        rel="noopener noreferrer"
        class="mt-2 inline-flex items-center justify-center gap-2 rounded-xl bg-wa px-4 py-3.5 text-base font-bold text-slate-900"
      >
        <Icon name="message-circle" class="h-5 w-5" />
        Konsultasi gratis
      </a>
    </div>
  </div>
</header>
