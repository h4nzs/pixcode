---
// Wordmark sementara — TODO(user): ganti dengan file logo asli saat dikirim (docs/WEBSITE-BRIEF.md checklist #8).
interface Props {
  class?: string;
  useWhite?: boolean;
}
const { class: className = "h-8 w-auto", useWhite = false } = Astro.props;
const text = useWhite ? "text-white" : "text-slate-900";
const squares = useWhite ? "fill-white" : "fill-brand-600";
---

<a href="/" class={`inline-flex items-center gap-2 ${className}`} aria-label="Pixcode Studio — beranda">
  <svg viewBox="0 0 28 28" class="h-full w-auto" aria-hidden="true">
    <rect x="1" y="1" width="12" height="12" rx="2" class={squares} opacity="0.45" />
    <rect x="15" y="1" width="12" height="12" rx="2" class={squares} opacity="0.75" />
    <rect x="1" y="15" width="12" height="12" rx="2" class={squares} opacity="0.6" />
    <rect x="15" y="15" width="12" height="12" rx="2" class={squares} />
  </svg>
  <span class={`text-lg font-extrabold tracking-tight ${text}`}>
    pix<span class="text-brand-500">code</span><span class={useWhite ? "text-white/60" : "text-slate-400"}>.studio</span>
  </span>
</a>
