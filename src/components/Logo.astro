---
// Logo Pixcode Studio: mark A (Staircase Four) + wordmark path.
// Header memakai lockup compact "pixcode"; footer/OG memakai lockup lengkap
// "pixcode STUDIO". Path di src/data/brand.ts agar wordmark tidak bergantung font.
import { wordmarkPath, studioPath, wordmarkDot, markBlocks, logoMetrics } from "../data/brand";

interface Props {
  class?: string;
  useWhite?: boolean;
  full?: boolean;
}
const { class: className = "h-8 w-auto", useWhite = false, full = false } = Astro.props;
const accent = useWhite ? "#5eead4" : "#14b8a6";
const anchor = useWhite ? "#ffffff" : "#0f766e";
const ink = useWhite ? "#ffffff" : "#0f172a";
const dot = useWhite ? "#5eead4" : "#14b8a6";
const studio = useWhite ? "#cbd5e1" : "#475569";
const width = (full ? logoMetrics.fullWidth : logoMetrics.compactWidth) + 1;
const wordTransform = `translate(${logoMetrics.wordTx} ${logoMetrics.wordTy}) scale(${logoMetrics.wordScale} -${logoMetrics.wordScale})`;
const studioTransform = `translate(${logoMetrics.studioTx} ${logoMetrics.studioTy}) scale(${logoMetrics.studioScale} -${logoMetrics.studioScale})`;
---

<a href="/" class={`inline-flex items-center ${className}`} aria-label="Pixcode Studio — beranda">
  <svg viewBox={`0 0 ${width} 32`} class="h-full w-auto" aria-hidden="true">
    {
      markBlocks.map((block) => (
        <rect
          x={block.x}
          y={block.y}
          width={block.w}
          height={block.h}
          rx={block.rx}
          fill={block.anchor ? anchor : accent}
        />
      ))
    }
    <g transform={wordTransform}>
      <path d={wordmarkPath} fill={ink} />
      <rect x={wordmarkDot.x} y={wordmarkDot.y} width={wordmarkDot.w} height={wordmarkDot.h} fill={dot} />
    </g>
    {full && (
      <g transform={studioTransform}>
        <path d={studioPath} fill={studio} />
      </g>
    )}
  </svg>
</a>
