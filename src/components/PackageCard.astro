---
import Icon from "./Icon.astro";
import WaButton from "./WaButton.astro";
import type { Package } from "../data/packages";

interface Props {
  pkg: Package;
}
const { pkg } = Astro.props;
---

<article
  class:list={[
    "card-lift relative flex flex-col rounded-2xl border bg-white p-6 shadow-sm",
    pkg.featured ? "animated-border border-brand-600 border-2 shadow-md" : "border-slate-200",
  ]}
>
  {
    pkg.featured && (
      <span class="absolute -top-3.5 left-6 rounded-full bg-brand-600 px-3 py-1 text-xs font-bold uppercase tracking-wide text-white shadow-sm">
        Paling Laris
      </span>
    )
  }

  <h3 class="text-lg font-bold text-slate-900">{pkg.name}</h3>
  <p class="mt-2 text-2xl font-extrabold tracking-tight text-brand-700">{pkg.price}</p>
  {pkg.priceNote && <p class="mt-1 text-xs text-slate-500">{pkg.priceNote}</p>}

  <dl class="mt-5 grid grid-cols-2 gap-3 rounded-lg bg-slate-50 p-3 text-xs">
    <div>
      <dt class="font-semibold uppercase tracking-wide text-slate-500">Revisi</dt>
      <dd class="mt-0.5 font-medium text-slate-700">{pkg.maxRevisions}</dd>
    </div>
    <div>
      <dt class="font-semibold uppercase tracking-wide text-slate-500">Pengerjaan</dt>
      <dd class="mt-0.5 font-medium text-slate-700">{pkg.duration}</dd>
    </div>
  </dl>

  <ul class="mt-5 flex-1 space-y-2.5 text-sm" aria-label="Termasuk dalam paket">
    {
      pkg.includes.map((item) => (
        <li class="flex items-start gap-2">
          <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-brand-600" strokeWidth={2.5} />
          <span class="text-slate-700">{item}</span>
        </li>
      ))
    }
  </ul>

  <details class="group mt-4 text-sm">
    <summary class="cursor-pointer list-none font-medium text-slate-500 transition-colors hover:text-slate-700">
      Tidak termasuk (add-on berbayar)
    </summary>
    <!-- Panel halus (murni CSS — pola sama dengan FAQ). -->
    <div class="faq-panel">
      <div>
        <ul class="space-y-2 pt-2" aria-label="Tidak termasuk dalam paket">
      {
        pkg.excludes.map((item) => (
          <li class="flex items-start gap-2">
            <Icon name="x" class="mt-0.5 h-4 w-4 shrink-0 text-slate-400" strokeWidth={2.5} />
            <span class="text-slate-500">{item}</span>
          </li>
        ))
      }
          </ul>
      </div>
    </div>
  </details>

  <div class="mt-6">
    <WaButton
      context={{ type: "package", packageName: `Paket ${pkg.name}` }}
      variant={pkg.featured ? "primary" : "ghost"}
      label={pkg.featured ? "Ambil Paket Ini" : "Tanya Paket Ini"}
      class="w-full"
    />
  </div>
</article>
