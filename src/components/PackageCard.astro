---
import Icon from "./Icon.astro";
import WaButton from "./WaButton.astro";
import type { Package } from "../data/packages";

interface Props {
  pkg: Package;
}
const { pkg } = Astro.props;
const dark = pkg.featured === true;
---

<article
  class:list={[
    "card-lift relative flex h-full flex-col rounded-[1.75rem] border p-7",
    dark ? "border-ink bg-ink text-slate-300" : "border-line bg-white",
  ]}
>
  {
    dark && (
      <span class="absolute -top-3.5 left-7 rounded-full bg-brand-500 px-3.5 py-1 text-xs font-extrabold text-ink">
        Paling laris
      </span>
    )
  }

  <h3 class:list={["text-xl font-extrabold tracking-tight", dark ? "text-white" : "text-slate-900"]}>{pkg.name}</h3>
  <p class:list={["mt-3 text-[2.1rem] font-extrabold leading-none tracking-tight", dark ? "text-white" : "text-slate-900"]}>
    {pkg.priceFrom && <span class:list={["mb-1.5 block text-sm font-semibold tracking-normal", dark ? "text-brand-300" : "text-slate-500"]}>Mulai dari</span>}{pkg.price}
  </p>
  {pkg.priceNote && <p class:list={["mt-3 text-sm leading-relaxed", dark ? "text-slate-400" : "text-slate-500"]}>{pkg.priceNote}</p>}

  <dl class:list={["mt-6 grid grid-cols-2 gap-4 border-y py-4 text-sm", dark ? "border-white/10" : "border-line"]}>
    <div>
      <dt class:list={["font-semibold", dark ? "text-slate-400" : "text-slate-500"]}>Revisi</dt>
      <dd class:list={["mt-1 font-bold", dark ? "text-white" : "text-slate-900"]}>{pkg.maxRevisions}</dd>
    </div>
    <div>
      <dt class:list={["font-semibold", dark ? "text-slate-400" : "text-slate-500"]}>Pengerjaan</dt>
      <dd class:list={["mt-1 font-bold", dark ? "text-white" : "text-slate-900"]}>{pkg.duration}</dd>
    </div>
  </dl>

  <ul class="mt-6 flex-1 space-y-3 text-[0.95rem]" aria-label="Termasuk dalam paket">
    {
      pkg.includes.map((item) => (
        <li class="flex items-start gap-3">
          <Icon name="check" class:list={["mt-1 h-4 w-4 shrink-0", dark ? "text-brand-300" : "text-brand-600"]} strokeWidth={2.75} />
          <span class={dark ? "text-slate-200" : "text-slate-700"}>{item}</span>
        </li>
      ))
    }
  </ul>

  <details class="group mt-5 text-sm">
    <summary class:list={["cursor-pointer list-none font-semibold underline decoration-dotted underline-offset-4 transition-colors", dark ? "text-slate-300 hover:text-white" : "text-slate-500 hover:text-slate-900"]}>
      Tidak termasuk
    </summary>
    <div class="faq-panel">
      <div>
        <ul class="space-y-2 pt-3" aria-label="Tidak termasuk dalam paket">
          {
            pkg.excludes.map((item) => (
              <li class="flex items-start gap-3">
                <Icon name="x" class:list={["mt-0.5 h-4 w-4 shrink-0", dark ? "text-slate-500" : "text-slate-400"]} strokeWidth={2.5} />
                <span class={dark ? "text-slate-400" : "text-slate-500"}>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </details>

  <div class="mt-7">
    <WaButton
      context={{ type: "package", packageName: `Paket ${pkg.name}` }}
      variant={dark ? "primary" : "ghost"}
      label={dark ? "Ambil paket ini" : "Tanya paket ini"}
      class="w-full"
    />
  </div>
</article>
