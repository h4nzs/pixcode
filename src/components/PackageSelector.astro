---
// Pemilih paket di beranda: daftar di kiri, rincian di panel gelap di kanan.
// Murni CSS (radio + :has()), tanpa JavaScript. Semua rincian tetap ada di DOM; halaman Layanan
// menampilkan semua paket sekaligus.
import Icon from "./Icon.astro";
import WaButton from "./WaButton.astro";
import { packages } from "../data/packages";
---

<div class="pkgsel grid gap-8 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-12">
  <fieldset class="m-0 min-w-0 border-0 p-0">
    <legend class="sr-only">Pilih paket untuk melihat rinciannya</legend>
    <ul class="divide-y divide-line border-y border-line">
      {
        packages.map((pkg, i) => (
          <li>
            <label class="pkg-row group flex cursor-pointer items-center gap-4 px-3 py-5 transition-colors duration-300 hover:bg-white/70 sm:px-5 sm:py-6">
              <input type="radio" name="paket" value={pkg.id} checked={i === 0} class="peer sr-only" />
              <span class="pkg-dot h-3 w-3 shrink-0 rounded-[3px] bg-slate-300 transition-all duration-500 peer-checked:scale-125 peer-checked:bg-brand-500" aria-hidden="true" />
              <span class="min-w-0 flex-1">
                <span class="block text-xl font-extrabold tracking-tight text-slate-900 sm:text-2xl">{pkg.name}</span>
                {pkg.featured && <span class="mt-0.5 block text-sm font-semibold text-brand-600">Paling laris</span>}
              </span>
              <span class="text-right">
                {pkg.priceFrom && <span class="block text-xs font-semibold text-slate-500">Mulai dari</span>}
                <span class="block text-lg font-extrabold tracking-tight text-slate-900 sm:text-xl">{pkg.price}</span>
              </span>
            </label>
          </li>
        ))
      }
    </ul>
    <p class="mt-5 px-3 text-sm leading-relaxed text-slate-500 sm:px-5">
      Cara bayar: DP 50%, sisanya lunas setelah kamu menyetujui demo. Revisi di luar batas paket diumumkan sejak proposal.
    </p>
  </fieldset>

  <div class="relative min-w-0">
    {
      packages.map((pkg) => (
        <article class="pkg-panel rounded-[2rem] bg-ink p-7 text-slate-300 sm:p-10" data-id={pkg.id} aria-label={`Rincian paket ${pkg.name}`}>
          <div class="flex flex-wrap items-start justify-between gap-4">
            <div>
              <h3 class="display text-3xl text-white sm:text-4xl">{pkg.name}</h3>
              <p class="mt-4 text-[2.4rem] font-extrabold leading-none tracking-tight text-white sm:text-5xl">
                {pkg.priceFrom && <span class="mb-2 block text-sm font-semibold tracking-normal text-brand-300">Mulai dari</span>}
                {pkg.price}
              </p>
            </div>
            {pkg.featured && <span class="rounded-full bg-brand-500 px-3.5 py-1 text-xs font-extrabold text-ink">Paling laris</span>}
          </div>
          {pkg.priceNote && <p class="mt-4 max-w-lg text-sm leading-relaxed text-slate-400">{pkg.priceNote}</p>}

          <dl class="mt-7 grid grid-cols-2 gap-6 border-y border-white/10 py-5 text-sm">
            <div>
              <dt class="font-semibold text-slate-400">Revisi</dt>
              <dd class="mt-1 font-bold text-white">{pkg.maxRevisions}</dd>
            </div>
            <div>
              <dt class="font-semibold text-slate-400">Pengerjaan</dt>
              <dd class="mt-1 font-bold text-white">{pkg.duration}</dd>
            </div>
          </dl>

          <ul class="mt-7 space-y-3.5" aria-label="Termasuk dalam paket">
            {
              pkg.includes.map((item) => (
                <li class="flex items-start gap-3">
                  <Icon name="check" class="mt-1 h-4 w-4 shrink-0 text-brand-300" strokeWidth={2.75} />
                  <span class="text-slate-200">{item}</span>
                </li>
              ))
            }
          </ul>

          <p class="mt-7 text-sm font-semibold text-slate-400">Tidak termasuk</p>
          <ul class="mt-3 space-y-2 text-sm" aria-label="Tidak termasuk dalam paket">
            {
              pkg.excludes.map((item) => (
                <li class="flex items-start gap-3">
                  <Icon name="x" class="mt-0.5 h-4 w-4 shrink-0 text-slate-500" strokeWidth={2.5} />
                  <span class="text-slate-400">{item}</span>
                </li>
              ))
            }
          </ul>

          <div class="mt-9 flex flex-wrap items-center gap-4">
            <WaButton context={{ type: "package", packageName: `Paket ${pkg.name}` }} size="large" label={pkg.featured ? "Ambil paket ini" : "Tanya paket ini"} />
            <a href="/layanan/#paket" class="btn-press inline-flex items-center gap-2 font-bold text-white underline decoration-white/30 underline-offset-8 hover:decoration-white">
              Bandingkan semua
              <Icon name="arrow-right" class="arrow h-5 w-5" />
            </a>
          </div>
        </article>
      ))
    }
  </div>
</div>

<style is:global>
  /* Hanya panel paket yang dipilih tampil; tanpa pilihan (sebelum JS/CSS apa pun) panel pertama dipakai. */
  .pkgsel .pkg-panel {
    display: none;
  }
  .pkgsel:has(input[value="umkm"]:checked) .pkg-panel[data-id="umkm"],
  .pkgsel:has(input[value="hemat"]:checked) .pkg-panel[data-id="hemat"],
  .pkgsel:has(input[value="hemat-plus"]:checked) .pkg-panel[data-id="hemat-plus"],
  .pkgsel:has(input[value="standar"]:checked) .pkg-panel[data-id="standar"],
  .pkgsel:has(input[value="pos"]:checked) .pkg-panel[data-id="pos"] {
    display: block;
    animation: pkg-in 0.6s var(--ease-out-soft) both;
  }
  .pkgsel .pkg-row:has(input:checked) {
    background: #fff;
  }
  .pkgsel .pkg-row:has(input:focus-visible) {
    outline: 2px solid var(--color-brand-600);
    outline-offset: -2px;
  }
  @keyframes pkg-in {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pkgsel .pkg-panel {
      animation: none !important;
    }
    .pkgsel .pkg-dot {
      transition: none;
    }
  }
</style>
